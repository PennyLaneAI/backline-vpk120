/ {
	memory@C000000000 {
		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0x60000000>;
	};
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*ps_reserved: buffer@0x60000000 {
			compatible = "shared-dma-pool";
                        no-map;
			xlnx,proc-access = <0x1>;
			reg = <0x00000000 0x60000000 0x0 0x20000000>;
        	};*/

		ps_reserved: buffer@0x60000000000 {
			compatible = "shared-dma-pool";
                        no-map;
			xlnx,proc-access = <0x1>;
                        reg = <0x00000600 0x00000000 0x0 0x80000000>, <0x00000680 0x80000000 0x0 0x80000000>;
        	};

		/*pl_reserved: buffer@0x400000000 {
			compatible = "shared-dma-pool";
                        no-map;
			xlnx,proc-access = <0x1>;
			reg = <0xC0 0x00000000 0x1 0x7F000000>;
		};*/

		pl_reserved: buffer@0x50000000000 {
			compatible = "shared-dma-pool";
                        no-map;
			xlnx,proc-access = <0x1>;
                        reg = <0x00000500 0x00000000 0x0 0x80000000>;
                };

		/*pl_db_mem: buffer@0x45F000000 {
			compatible = "shared-dma-pool";
                        //no-map;
			xlnx,proc-access = <0x1>;
			reg = <0xC1 0x7F000000 0x0 0x1000000>;
		};*/

		pl_db_mem: buffer@0x58000000000 {
			compatible = "shared-dma-pool";
                        //no-map;
			xlnx,proc-access = <0x1>;
			reg = <0x00000580 0x00000000 0x0 0x80000000>;
		};
	};

	pl_allocator@1 {
		compatible = "xlnx,pl-allocator-1.0";
		memory-region = <&pl_db_mem>;
	};

	xib_kmm@2 {
		compatible = "xlnx,xib-kmm-1.0";
		memory-region = <&ps_reserved>;
		pl-mem-region = <&pl_reserved>;
	};
};
/*&cips_block_axi_gpio_gt_reset_mask {
	compatible = "xlnx,axi-gpio-2.0";
};
&cips_block_gtctrl {
	compatible = "xlnx,axi-gpio-2.0";
};
*/

&axi_dma_0 {
	xlnx,include-dre ;
};

&ernic_subsystem_ernic_1 {
	interrupt-names = "xrnic_intr0";
	eth-handle = <&dcmac_0_core>;
        //xlnx,num-qp = <0x800>;
};

&memoryaxi_noc_0_ddr {
	reg = <0x0 0x00000000 0x0 0x80000000>;
};
&memoryaxi_noc_1_ddr {
        status = "disabled";
};

&memoryaxi_noc_2_ddr {
        status = "disabled";
};

&amba_pl {
        axi_bram_ctrl_0: axi_bram_ctrl@a0000000 {
                compatible = "xlnx,axi-bram-ctrl-4.1";
                reg = <0x0 0x90000000 0x0 0x100000>;
                xlnx,proc-access = <0x0>;
        };
        axi_bram_ctrl_1: axi_bram_ctrl@91000000 {
                compatible = "xlnx,axi-bram-ctrl-4.1";
                reg = <0x0 0x91000000 0x0 0x200000>;
                xlnx,proc-access = <0x1>;
        };
	misc_clk_2: misc_clk_2 {
	            compatible = "fixed-clock";
		    clock-frequency = <100000000>;
		    #clock-cells = <0>;
        };
	misc_clk_1: misc_clk_1 {
		compatible = "fixed-clock";
		clock-frequency = <781250000>;
		#clock-cells = <0>;
	};
	/*misc_clk_0: misc_clk_0 {
		compatible = "fixed-clock";
		clock-frequency = <390625000>;
		#clock-cells = <0>;
	};*/
	gpioc: gpio@a4150000 {
		xlnx,gpio-board-interface = "Custom";
		compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a" , "xlnx,xps-gpio-1.00.a";
		xlnx,all-outputs = <1>;
		#gpio-cells = <2>;
		xlnx,gpio-width = <32>;
		xlnx,rable = <0>;
		xlnx,dout-default = <0x0>;
		xlnx,is-dual = <0>;
		xlnx,ip-name = "axi_gpio";
		xlnx,tri-default-2 = <0xffffffff>;
		reg = <0x0 0xa4150000 0x0 0x10000>;
		xlnx,all-inputs-2 = <0>;
		clocks = <&versal_clk 65>;
		xlnx,all-outputs-2 = <0>;
		gpio-controller;
		xlnx,interrupt-present = <0>;
		xlnx,gpio2-board-interface = "Custom";
		xlnx,edk-iptype = "PERIPHERAL";
		xlnx,dout-default-2 = <0x0>;
		status = "okay";
		xlnx,gpio2-width = <32>;
		clock-names = "s_axi_aclk";
		xlnx,tri-default = <0xffffffff>;
		xlnx,name = "gpio1";
		xlnx,all-inputs = <0>;
	};

	gpio_rx_d: gpio@a4160000 {
		xlnx,gpio-board-interface = "Custom";
		compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a" , "xlnx,xps-gpio-1.00.a";
		xlnx,all-outputs = <1>;
		#gpio-cells = <2>;
		xlnx,gpio-width = <32>;
		xlnx,rable = <0>;
		xlnx,dout-default = <0x0>;
		xlnx,is-dual = <0>;
		xlnx,ip-name = "axi_gpio";
		xlnx,tri-default-2 = <0xffffffff>;
		reg = <0x0 0xa4160000 0x0 0x10000>;
		xlnx,all-inputs-2 = <0>;
		clocks = <&versal_clk 65>;
		xlnx,all-outputs-2 = <0>;
		gpio-controller;
		xlnx,interrupt-present = <0>;
		xlnx,gpio2-board-interface = "Custom";
		xlnx,edk-iptype = "PERIPHERAL";
		xlnx,dout-default-2 = <0x0>;
		status = "okay";
		xlnx,gpio2-width = <32>;
		clock-names = "s_axi_aclk";
		xlnx,tri-default = <0xffffffff>;
		xlnx,name = "gpio_rx_d";
		xlnx,all-inputs = <0>;
	};

	gpio_tx_d: gpio@a4170000 {
		xlnx,gpio-board-interface = "Custom";
		compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a" , "xlnx,xps-gpio-1.00.a";
		xlnx,all-outputs = <1>;
		#gpio-cells = <2>;
		xlnx,gpio-width = <32>;
		xlnx,rable = <0>;
		xlnx,dout-default = <0x0>;
		xlnx,is-dual = <0>;
		xlnx,ip-name = "axi_gpio";
		xlnx,tri-default-2 = <0xffffffff>;
		reg = <0x0 0xa4170000 0x0 0x10000>;
		xlnx,all-inputs-2 = <0>;
		clocks = <&versal_clk 65>;
		xlnx,all-outputs-2 = <0>;
		gpio-controller;
		xlnx,interrupt-present = <0>;
		xlnx,gpio2-board-interface = "Custom";
		xlnx,edk-iptype = "PERIPHERAL";
		xlnx,dout-default-2 = <0x0>;
		status = "okay";
		xlnx,gpio2-width = <32>;
		clock-names = "s_axi_aclk";
		xlnx,tri-default = <0xffffffff>;
		xlnx,name = "gpio_tx_d";
		xlnx,all-inputs = <0>;
	};

	r_done_dyn: gpio@a4180000 {
		#interrupt-cells = <2>;
		interrupts = < 0 88 4 >;
		xlnx,gpio-board-interface = "Custom";
		compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a" , "xlnx,xps-gpio-1.00.a";
		xlnx,all-outputs = <0>;
		#gpio-cells = <2>;
		xlnx,gpio-width = <24>;
		//interrupt-parent = <&imux>;
		xlnx,rable = <0>;
		xlnx,dout-default = <0x0>;
		xlnx,is-dual = <1>;
		xlnx,ip-name = "axi_gpio";
		xlnx,tri-default-2 = <0xffffffff>;
		reg = <0x0 0xa4180000 0x0 0x10000>;
		xlnx,all-inputs-2 = <1>;
		clocks = <&versal_clk 65>;
		xlnx,all-outputs-2 = <0>;
		gpio-controller;
		xlnx,interrupt-present = <1>;
		xlnx,gpio2-board-interface = "Custom";
		xlnx,edk-iptype = "PERIPHERAL";
		xlnx,dout-default-2 = <0x0>;
		status = "okay";
		xlnx,gpio2-width = <24>;
		clock-names = "s_axi_aclk";
		interrupt-controller;
		interrupt-names = "ip2intc_irpt";
		xlnx,tri-default = <0xffffffff>;
		xlnx,name = "r_done_dyn";
		xlnx,all-inputs = <1>;
	};

	r_dyn: gpio@a4190000 {
		xlnx,gpio-board-interface = "Custom";
		compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a" , "xlnx,xps-gpio-1.00.a";
		xlnx,all-outputs = <1>;
		#gpio-cells = <2>;
		xlnx,gpio-width = <14>;
		xlnx,rable = <0>;
		xlnx,dout-default = <0x0>;
		xlnx,is-dual = <0>;
		xlnx,ip-name = "axi_gpio";
		xlnx,tri-default-2 = <0xffffffff>;
		reg = <0x0 0xa4190000 0x0 0x10000>;
		xlnx,all-inputs-2 = <0>;
		clocks = <&versal_clk 65>;
		xlnx,all-outputs-2 = <0>;
		gpio-controller;
		xlnx,interrupt-present = <0>;
		xlnx,gpio2-board-interface = "Custom";
		xlnx,edk-iptype = "PERIPHERAL";
		xlnx,dout-default-2 = <0x0>;
		status = "okay";
		xlnx,gpio2-width = <32>;
		clock-names = "s_axi_aclk";
		xlnx,tri-default = <0xffffffff>;
		xlnx,name = "r_dyn";
		xlnx,all-inputs = <0>;
	};

        dcmac_0_core: dcmac@a4000000 {
                      xlnx,addrwidth = <32>;
                      axistream-connected = <&axi_dma_0>;
                      reg = <0x0 0xa4000000 0x0 0x100000>;
                      interrupt-parent = <&gic>;
                      interrupts = <0x0 0x5c 0x4 0x0 0x5d 0x4>;
                      phy-mode = "100gbase-r"; /* Interface mode specification */
                      max-speed = <0x186A0>;
                      xlnx,rxmem = <0x8000>;
                      xlnx,txmem = <0x8000>;
                      gt_ctrl-gpios = <&gpioc 0 0>, <&gpioc 1 0>, <&gpioc 2 0>, <&gpioc 3 0>, <&gpioc 4 0>, <&gpioc 5 0>, <&gpioc 6 0>, <&gpioc 7 0>,
