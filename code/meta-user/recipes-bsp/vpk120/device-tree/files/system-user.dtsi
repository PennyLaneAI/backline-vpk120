                      <&gpio_rx_d 16 0>, <&gpio_rx_d 17 0>, <&gpio_rx_d 18 0>, <&gpio_rx_d 19 0>, <&gpio_rx_d 20 0>, <&gpio_rx_d 21 0>, <&gpio_rx_d 22 0>;

                      gt_tx_dpath-gpios = <&gpio_tx_d 0 0>, <&gpio_tx_d 1 0>, <&gpio_tx_d 2 0>, <&gpio_tx_d 3 0>, <&gpio_tx_d 4 0>, <&gpio_tx_d 5 0>, <&gpio_tx_d 6 0>, <&gpio_tx_d 7 0>,
                      <&gpio_tx_d 8 0>, <&gpio_tx_d 9 0>, <&gpio_tx_d 10 0>, <&gpio_tx_d 11 0>, <&gpio_tx_d 12 0>, <&gpio_tx_d 13 0>, <&gpio_tx_d 14 0>, <&gpio_tx_d 15 0>,
                      <&gpio_tx_d 16 0>, <&gpio_tx_d 17 0>, <&gpio_tx_d 18 0>, <&gpio_tx_d 19 0>, <&gpio_tx_d 20 0>, <&gpio_tx_d 21 0>, <&gpio_tx_d 22 0>;

                      gt_tx_rst_done-gpios = <&r_done_dyn 0 0>, <&r_done_dyn 1 0>, <&r_done_dyn 2 0>, <&r_done_dyn 3 0>, <&r_done_dyn 4 0>, <&r_done_dyn 5 0>, <&r_done_dyn 6 0>, <&r_done_dyn 7 0>,
                      <&r_done_dyn 8 0>, <&r_done_dyn 9 0>, <&r_done_dyn 10 0>, <&r_done_dyn 11 0>, <&r_done_dyn 12 0>, <&r_done_dyn 13 0>, <&r_done_dyn 14 0>, <&r_done_dyn 15 0>,
                      <&r_done_dyn 16 0>, <&r_done_dyn 17 0>, <&r_done_dyn 18 0>, <&r_done_dyn 19 0>, <&r_done_dyn 20 0>, <&r_done_dyn 21 0>, <&r_done_dyn 22 0>, <&r_done_dyn 23 0>;

                      gt_rx_rst_done-gpios =  <&r_done_dyn 24 0>, <&r_done_dyn 25 0>, <&r_done_dyn 26 0>, <&r_done_dyn 27 0>,
                      <&r_done_dyn 28 0>, <&r_done_dyn 29 0>, <&r_done_dyn 30 0>, <&r_done_dyn 31 0>, <&r_done_dyn 32 0>, <&r_done_dyn 33 0>,
                      <&r_done_dyn 34 0>, <&r_done_dyn 35 0>, <&r_done_dyn 36 0>, <&r_done_dyn 37 0>, <&r_done_dyn 38 0>, <&r_done_dyn 39 0>,
                      <&r_done_dyn 40 0>, <&r_done_dyn 41 0>, <&r_done_dyn 42 0>, <&r_done_dyn 43 0>, <&r_done_dyn 44 0>, <&r_done_dyn 45 0>,
                      <&r_done_dyn 46 0>, <&r_done_dyn 47 0>;

                      gt_rsts-gpios = <&r_dyn 0 0>, <&r_dyn 1 0>, <&r_dyn 2 0>, <&r_dyn 3 0>, <&r_dyn 4 0>, <&r_dyn 5 0>, <&r_dyn 6 0>, <&r_dyn 7 0>,
                      <&r_dyn 8 0>, <&r_dyn 9 0>, <&r_dyn 10 0>, <&r_dyn 11 0>, <&r_dyn 12 0>, <&r_dyn 13 0>;

	              xlnx,gt-ch0-rx-user-data-width-c0 = <80>;
	              xlnx,gt-mode-0 = "NRZ";
