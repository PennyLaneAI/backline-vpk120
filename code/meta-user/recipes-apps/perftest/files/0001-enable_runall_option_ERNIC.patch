 		if (user_param.connection_type == UD)
 			size_max_pow =  (int)UD_MSG_2_EXP(MTU_SIZE(user_param.curr_mtu)) + 1;
-
-		for (i = 1; i < size_max_pow ; ++i) {
+                /*ERNIC doesn't support payload size < 16B and payload size = pow(2,i), so we need to for loop from i=4*/
+		for (i = 4; i < size_max_pow ; ++i) {
 
 			user_param.size = (uint64_t)1 << i;
 
diff --git a/src/send_lat.c b/src/send_lat.c
index bc194d8..810ce27 100755
--- a/src/send_lat.c
+++ b/src/send_lat.c
@@ -401,8 +401,8 @@ int main(int argc, char *argv[])
 
 		if (user_param.connection_type == UD)
 			size_max_pow =  (int)UD_MSG_2_EXP(MTU_SIZE(user_param.curr_mtu)) + 1;
-
-		for (i = 1; i < size_max_pow ; ++i) {
+                /*ERNIC doesn't support payload size < 16B and payload size = pow(2,i), so we need to for loop from i=4*/
+		for (i = 4; i < size_max_pow ; ++i) {
 
 			user_param.size = (uint64_t)1 << i;
 
diff --git a/src/write_bw.c b/src/write_bw.c
index cb31410..1235c50 100755
--- a/src/write_bw.c
+++ b/src/write_bw.c
@@ -256,8 +256,8 @@ int main(int argc, char *argv[])
 	}
 
 	if (user_param.test_method == RUN_ALL) {
-
-		for (i = 1; i < 24 ; ++i) {
+                /*ERNIC doesn't support payload size < 16B and payload size = pow(2,i), so we need to for loop from i=4*/
+		for (i = 4; i < 24 ; ++i) {
 
 			user_param.size = (uint64_t)1 << i;
 			ctx_set_send_wqes(&ctx,&user_param,rem_dest);
diff --git a/src/write_lat.c b/src/write_lat.c
index 5e83260..1748c1f 100755
--- a/src/write_lat.c
+++ b/src/write_lat.c
@@ -227,8 +227,8 @@ int main(int argc, char *argv[])
 	}
 
 	if (user_param.test_method == RUN_ALL) {
-
-		for (i = 1; i < 24 ; ++i) {
+                /*ERNIC doesn't support payload size < 16B and payload size = pow(2,i), so we need to for loop from i=4*/
+		for (i = 4; i < 24 ; ++i) {
 			user_param.size = (uint64_t)1 << i;
 			if(run_iter_lat_write(&ctx,&user_param)) {
 				fprintf(stderr,"Test exited with Error\n");
