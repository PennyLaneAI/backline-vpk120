From: dhruv28varshney <dhruvv@xilinx.com>
Date: Wed, 13 Apr 2022 12:43:57 +0530
Subject: [PATCH] enable_runall_option_ERNIC

Signed-off-by: dhruv28varshney <dhruvv@xilinx.com>
---
 src/read_bw.c   | 4 ++--
 src/read_lat.c  | 3 ++-
 src/send_bw.c   | 4 ++--
 src/send_lat.c  | 4 ++--
 src/write_bw.c  | 4 ++--
 src/write_lat.c | 4 ++--
 6 files changed, 12 insertions(+), 11 deletions(-)

diff --git a/src/read_bw.c b/src/read_bw.c
index d5dde51..e525ee7 100755
--- a/src/read_bw.c
+++ b/src/read_bw.c
@@ -259,8 +259,8 @@ int main(int argc, char *argv[])
 	}
 
 	if (user_param.test_method == RUN_ALL) {
-
-		for (i = 1; i < 24 ; ++i) {
+                /*ERNIC doesn't support payload size < 16B and payload size = pow(2,i), so we need to for loop from i=4*/
+		for (i = 4; i < 24 ; ++i) {
 
 			user_param.size = (uint64_t)1 << i;
 			ctx_set_send_wqes(&ctx,&user_param,rem_dest);
diff --git a/src/read_lat.c b/src/read_lat.c
index 2a9beb9..34f3f39 100755
--- a/src/read_lat.c
+++ b/src/read_lat.c
@@ -249,7 +249,8 @@ int main(int argc, char *argv[])
 	ctx_set_send_wqes(&ctx,&user_param,rem_dest);
 
 	if (user_param.test_method == RUN_ALL) {
-		for (i = 1; i < 24 ; ++i) {
+                /*ERNIC doesn't support payload size < 16B and payload size = pow(2,i), so we need to for loop from i=4*/
+		for (i = 4; i < 24 ; ++i) {
 			user_param.size = (uint64_t)1 << i;
 			if(run_iter_lat(&ctx,&user_param))
 				return 17;
