+
+    hh_orchestrator #(
+        .C_M_AXI_ADDR_WIDTH(C_M_AXI_ADDR_WIDTH),
+        .C_M_AXI_DATA_WIDTH(C_M_AXI_DATA_WIDTH),
+        .C_QP_IDX_WIDTH(C_QP_IDX_WIDTH),
+        .C_WQE_IDX_WIDTH(C_WQE_IDX_WIDTH),
+        .C_CTX_IDX_WIDTH(C_CTX_IDX_WIDTH),
