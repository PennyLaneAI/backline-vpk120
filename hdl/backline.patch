+        .i_send_cq_db_cnt_valid(sq_cq_db_vld),
+        .i_send_cq_db_addr(sq_cq_db_addr),
+        .i_send_cq_db_cnt(sq_cq_db_data),
+        .o_send_cq_db_rdy(sq_cq_db_rdy),
+        .i_rq_pi_db_vld(rq_pi_db_vld),
+        .i_rq_pi_db_addr(rq_pi_db_addr),
