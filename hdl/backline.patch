+        .buf_ring_adv_idx(buf_ring_adv_idx),
+        .buf_ring_adv_len(buf_ring_adv_len),
+        .sts_state(c_state),
+        .sts_busy(c_busy),
+        .sts_done(c_done),
+        .sts_timeout(c_timeout),
+        .sts_axi_err(c_axi_err),
+        .sts_reply_seen(c_reply_seen),
+        .sts_round_cnt(c_round_cnt),
