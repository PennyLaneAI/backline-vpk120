+        .m_axis_tlast(m_axis_tlast),
+        .dma_req(dma_req),
+        .dma_addr(dma_addr),
+        .dma_beats(dma_beats),
+        .dma_fill(dma_fill),
+        .dma_busy(dma_busy),
+        .dma_done(dma_done),
+        .dma_err(dma_err),
+        .reply_slot_o(reply_slot_o),
+        .rd_data(reply_ram_dout),
+        .ring_req(ring_req),
+        .ring_qp(ring_qp),
+        .ring_pi(ring_pi),
+        .ring_done(ring_done),
+        .send_compl(send_compl),
+        .reply(reply),
+        .reply_qp(reply_qp),
+        // QP-context table (hh_qp_ctx)
+        .qpc_rd_ctx(qpc_rd_ctx),
+        .qpc_qp_num(qpc_qp_num),
+        .qpc_sq_base(qpc_sq_base),
+        .qpc_sq_depth(qpc_sq_depth),
+        .qpc_sq_pi(qpc_sq_pi),
+        .qpc_complete_on_send(qpc_complete_on_send),
+        .qpc_reply_poll(qpc_reply_poll),
+        .qpc_reply_to(qpc_reply_to),
+        .qpc_reply_seq_off(qpc_reply_seq_off),
+        .qpc_reply_stride_log2(qpc_reply_stride_log2),
+        .qpc_adv(qpc_adv),
+        .qpc_adv_idx(qpc_adv_idx),
+        // ring-index table (hh_ring_state)
