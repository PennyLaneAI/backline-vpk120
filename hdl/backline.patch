+
+# Load ERNIC kernel modules
+modprobe xilinx_kmm
+modprobe xilinx_ib max_q_depth=64 max_rq_sge=32 cq_mem="pl" sq_mem="pl" rq_mem="pl" max_app_qp=256 rtime=16
+modprobe hw_hs
+
+# Configure secondary interface end0
+ip addr add 192.168.3.15/24 dev end0
+ip link set end0 up
+
+# Configure static neighbor ARP entry (replace with actual target MAC address)
+ip neigh replace 192.168.1.2 lladdr XX:XX:XX:XX:XX:XX dev eth0 nud permanent
