+#define HH_REG_WQE_RKEY 0x48       // remote key
+#define HH_REG_WQE_VA_LO 0x4C      // remote VA [31:0]
+#define HH_REG_WQE_VA_HI 0x50      // remote VA [63:32]
+#define HH_REG_WQE_OFFS_LO 0x54    // local offset (DDR buf addr) [31:0]
