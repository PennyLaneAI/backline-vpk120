diff -r -N -U0 -w -B a/sw/sw_build.sh b/sw/sw_build.sh
--- a/sw/sw_build.sh	1969-12-31 19:00:00.000000000 -0500
+++ b/sw/sw_build.sh	2026-08-27 09:49:29.253387722 -0400
@@ -0,0 +1,57 @@
+#!/bin/bash
+# Exit immediately if a command exits with a non-zero status
+set -e 
+
+export ERNIC_PROJ_DIR="${SW_DIR}"
+export HW_PROJ_DIR="${HW_DIR}"
+
+export XSA_PATH="${XSA_PATH}"
+export BSP_PATH="${BSP_PATH}"
+export VPK_INIT_CONFIG_DIR="${VPK_INIT_CONFIG_DIR}"
+
+if [ -z "$BSP_PATH" ] || [ -z "$VPK_INIT_CONFIG_DIR" ]; then
+    echo "ERROR: Missing environment variables. Please run 'source sourceme.sh' first."
+    exit 1
+fi
+
+# Petalinux Variables
+export PROJECT_NAME="ernic"
+export PETALINUX_VERSION="2024"
+export PETALINUX_MINOR_VERSION=".2"
+export DEFAULT_HDF_SVN_VERSION="bsp"
+
+echo "==> Creating PetaLinux project from BSP and XSA..."
+cd $ERNIC_PROJ_DIR/peta_proj/ernic
+
+# Run your custom build script with the required arguments
+./build_peta_proj -o vpk120_mrmac -x "$XSA_PATH" -b "$BSP_PATH"
+
+echo "PETALINUX BUILD"
+cd $ERNIC_PROJ_DIR/peta_proj/ernic/vpk120_mrmac/amd-ernic-vpk120_mrmac-2024-bsp
+
+# Startup app to configure vpk link
+petalinux-create -t apps --template install -n vpk-init --enable
+cp "$VPK_INIT_CONFIG_DIR/vpk-init" $ERNIC_PROJ_DIR/peta_proj/ernic/vpk120_mrmac/amd-ernic-vpk120_mrmac-2024-bsp/project-spec/meta-user/recipes-apps/vpk-init/files/vpk-init.sh
+cp "$VPK_INIT_CONFIG_DIR/vpk-init.service" $ERNIC_PROJ_DIR/peta_proj/ernic/vpk120_mrmac/amd-ernic-vpk120_mrmac-2024-bsp/project-spec/meta-user/recipes-apps/vpk-init/files/vpk-init.service
+cp "$VPK_INIT_CONFIG_DIR/vpk-init.bb" $ERNIC_PROJ_DIR/peta_proj/ernic/vpk120_mrmac/amd-ernic-vpk120_mrmac-2024-bsp/project-spec/meta-user/recipes-apps/vpk-init/vpk-init.bb
+
+petalinux-create -t apps --name xmm-env --enable
+cp "$VPK_INIT_CONFIG_DIR/xmm-env.bb" $ERNIC_PROJ_DIR/peta_proj/ernic/vpk120_mrmac/amd-ernic-vpk120_mrmac-2024-bsp/project-spec/meta-user/recipes-apps/xmm-env/xmm-env.bb
+
+ROOTFS_CONFIG="project-spec/configs/rootfs_config"
+TARGET_PARAM='CONFIG_ADD_EXTRA_USERS="root:root;petalinux:2024;"'
+
+# Check if CONFIG_ADD_EXTRA_USERS is present (active or commented out)
+if grep -q "CONFIG_ADD_EXTRA_USERS" "$ROOTFS_CONFIG"; then
+    # Replace existing line with new password configuration
+    sed -i "s|^.*CONFIG_ADD_EXTRA_USERS.*|$TARGET_PARAM|" "$ROOTFS_CONFIG"
+else
+    # Append to the bottom of the file if key does not exist
+    echo "$TARGET_PARAM" >> "$ROOTFS_CONFIG"
+fi
+
+petalinux-config -c rootfs --silentconfig
+petalinux-build
+petalinux-package --boot --format BIN --plm --psmfw --u-boot --dtb --force
+
+echo "BUILD SUCCESS"
