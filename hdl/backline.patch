+//===----------------------------------------------------------------------===//
+//
+// hh_axil_regs.v
+// MMIO control/status window for the Hardware Handshake Engine.
+//
+//===----------------------------------------------------------------------===//
+///
+/// config outputs are quasi-static (written before CTRL.start)
+///
+/// Register map (byte offsets):
+///------------------------------------------------------------------------------
+///   0x00 CTRL      W1P [0]=start
+///                  RW  [1]=abort
+///                  RW  [2]=soft_reset
+///------------------------------------------------------------------------------
+///   0x04 STATUS    RO  [3:0]=state
+///                      [4]=busy
+///                      [5]=done
+///                      [6]=reply_seen
+///                      [7]=timeout
+///                      [8]=axi_err
+///------------------------------------------------------------------------------
+///   0x08 QP_NUM    RW  ERNIC QP number
+///   0x0C PAY_LEN   RW  payload bytes (<=4096 (4KB), multiple of 64)
+///   0x10 PATTERN   RW  32-bit fixed pattern (replicated across 64B) Only for debugging
+///   0x14 DBUF_LO   RW  local send-buffer DDR address [ 31:0]
+///   0x18 DBUF_HI   RW                                [63:32]
+///   0x1C SQBASE_LO RW  SQ ring base DDR address [ 31:0]
+///   0x20 SQBASE_HI RW                           [63:32]
+///   0x24 SQ_DEPTH  RW  SQ ring depth (entries)
+///------------------------------------------------------------------------------
+///   0x28 FLAGS     RW  [0]=repost_wqe(=1 default;
+///                                     =0 TODO skip reposting the WQE; haven't finished this opt)
+///                      [1]=write_payload (=0 default: engine doesn't write the fixed pattern)
+///                      [2]=complete_on_send (
+///                           1: round done on send-CQ completion;
+///                           0: on inbound RQ reply
+///                          )
+///                      [3]=reply_poll (=0 default: no reply polling; 1: polling reply buffer)
+///------------------------------------------------------------------------------
+///   0x30 REPLY_TO       RW  reply timeout in core cycles (0: wait forever)
+///   0x34 ROUND_CNT      RO  completed rounds (for now, it is always 1)
+///   0x38 RTT_LO         RO  round cycle count, measured from START to reply [ 31:0]
+///   0x3C RTT_HI         RO                                                  [63:32]
+///------------------------------------------------------------------------------
+///   0x40 WQE_OPCODE     RW [ 1:0]  opcode (00 write, 01 read, 10 send)
+///   0x44 WQE_XFER_LEN   RW [31:0] RDMA transfer length in bytes (e.g. 64)
+///   0x48 WQE_RKEY       RW [31:0] remote key
+///   0x4C WQE_VA_LO      RW [31:0] remote VA [31:0]
+///   0x50 WQE_VA_HI      RW [31:0] remote VA [63:32]
+///   0x54 WQE_OFFS_LO    RW [31:0] local offset (DDR buf addr) [31:0]
+///   0x58 WQE_OFFS_HI    RW [31:0]                             [63:32]
+///   0x5C WQE_WRID       RW [15:0] WQE id (TODO: not used in this version, always 0)
+///   0x60 WQE_COMMIT     W  [ idx]  assemble current fields and store at WQE store[idx]
+///   0x64 RUN_WQE_IDX    RW [ idx]  fetches and sends
+///------------------------------------------------------------------------------
+///   0x68 TIMER_QP_SEL   RW [qp]  selects the QP whose reply latches RTT (TODO: unused for now)
+///   0x6C REPLY_BUF_LO   RW       per-QP reply buffer base [ 31:0] (QP-context staging;
+///   0x70 REPLY_BUF_HI   RW                                [63:32] committed by QPCTX_COMMIT)
+///   0x74 REPLY_SEQ_OFF  RW       byte offset of seq_num inside a reply slot (reply_poll mode).
+///   0x78 LAST_RD        RO       DEBUG: last seq_num the reply-poll READ got
+///------------------------------------------------------------------------------
+///   0x7C QPCTX_COMMIT   W  [2:0]=ctx  latch the QP-context staging set into QP-context[ctx]:
+///                                 {QP_NUM, SQBASE, SQ_DEPTH, REPLY_BUF, complete_on_send,
+///                                  reply_poll, REPLY_TO, REPLY_SEQ_OFF, REPLY_RING}
+///                          [31]=rebind  zero this ctx's sq_pi
+///                               (set iff the caller (re)creates a QP + zeroes its SQPI)
+///------------------------------------------------------------------------------
+///   0x84 WQE_QP_REF     RW [ctx]  qp_ref of the WQE being built
+///   0x88 WQE_RING_CFG   RW [0]=buf_ring_en (rings LADDR + ROFFSET + reply together)
+///                          [13:8]=stride_local_log2  (local slot size, log2 bytes)
+///                          [21:16]=stride_remote_log2 (remote slot size, log2 bytes)
+///   0x8C WQE_RING_LEN   RW [15:0] ring length (number of buffers in the pool)
+///   0x90 RING_RESET     W  [idx] zero that WQE's buf_ring_idx
+///   0x94 REPLY_RING     RW [5:0]=reply_stride_log2
+///   0xA8 REG_DEMO_CTRL  RW [0] start_demo [1] reset_demo
+///   0xAC REG_FREQ_LO
+///   0xB0 REG_FREQ_HI
+///   0xB4 REG_DEMO_STS RO [0] demo_sts_done
+///   0xB8 REG_CMD_CNT RW [31:0] command_count
+///   0xBC REG_STS1 RO [31:0] demo_err
+///   0xC0 REG_DEMO_CTRL_2 RW [31:0] demo_syn_depth
+///   0xC4 REG_FREQ_SPAN  RW [31:0] pacer jitter mask (0 = fixed interval)
+///   0xC8 REG_LFSR_SEED  RW [31:0] pacer jitter seed (0 = default)
+///   0xCC REG_TRACE_CTRL RW [0]=trace_clear. Hold it high to keep the RTT trace empty.
+//                        drop it to start recording. Have to raise it again before a new demo run.
+///   0xD0 REG_TRACE_CNT  RO [31:0] rtt trace entries recorded so far.
+///   0xD4 REG_TRACE_STS  RO [0]=full
+///                          [1]=saturated (some round exceeded 16 bits and was clamped to 0xFFFF)
+//===----------------------------------------------------------------------===//
+`timescale 1ps / 1ps `default_nettype none
+
+module hh_axil_regs #(
+    parameter integer C_S_AXI_ADDR_WIDTH = 12,   // For aligning to 4KB
+    parameter integer C_S_AXI_DATA_WIDTH = 32,
+    parameter integer C_M_AXI_ADDR_WIDTH = 64,
+    parameter integer C_M_AXI_DATA_WIDTH = 512,
+    // ERNIC: up to 255 QPs -> 8-bit index
+    parameter integer C_QP_IDX_WIDTH     = 8,
+    // supports up to 16 WQE stored in the array for selection
+    parameter integer C_WQE_IDX_WIDTH    = 4,
+    // QP-context table depth (story 005): K active contexts, qp_ref = clog2(K)
+    parameter integer C_NUM_CTX          = 8,
+    parameter integer C_CTX_IDX_WIDTH    = 3
+) (
+    input  wire                          s_axi_aclk,
+    input  wire                          s_axi_aresetn,
+    input  wire [C_S_AXI_ADDR_WIDTH-1:0] s_axi_awaddr,
+    input  wire                          s_axi_awvalid,
+    output reg                           s_axi_awready,
+    input  wire [C_S_AXI_ADDR_WIDTH-1:0] s_axi_araddr,
+    output reg                           s_axi_arready,
+    input  wire                          s_axi_arvalid,
+    input  wire [C_S_AXI_DATA_WIDTH-1:0] s_axi_wdata,
+    input  wire [                   3:0] s_axi_wstrb,
+    output reg                           s_axi_wready,
+    input  wire                          s_axi_wvalid,
+    output reg  [C_S_AXI_DATA_WIDTH-1:0] s_axi_rdata,
+    output reg  [                   1:0] s_axi_rresp,
+    input  wire                          s_axi_rready,
+    output reg                           s_axi_rvalid,
+    output reg  [                   1:0] s_axi_bresp,
+    input  wire                          s_axi_bready,
+    output reg                           s_axi_bvalid,
+
+    // CTRL
+    output reg start_tgl,
+    output reg abort,
+    output reg soft_reset,
+
+    // STATUS
+    input wire [ 3:0] sts_state,
+    input wire        sts_busy,
+    input wire        sts_done,
+    input wire        sts_reply_seen,
+    input wire        sts_timeout,
+    input wire        sts_axi_err,
+    input wire [31:0] sts_round_cnt,   // completed rounds (TODO: for now, it is always 1)
+    input wire [63:0] sts_rtt,
+    input wire [31:0] sts_last_rd,     // DEBUG: last value the reply-poll READ returned
+
+    // CONFIG
+    output reg [C_QP_IDX_WIDTH-1:0] cfg_qp_num,
+    output reg [12:0] cfg_payload_len,  // the maximum payload length is 4096 (4KB)
+    output reg [31:0] cfg_pattern,
+    output reg [C_M_AXI_ADDR_WIDTH-1:0] cfg_data_buf,
+    output reg [C_M_AXI_ADDR_WIDTH-1:0] cfg_sq_base,
+    output reg [15:0] cfg_sq_depth,
+
+    // FLAGS:
+    // repost_wqe/write_payload are engine-global
+    // complete_on_send/reply_poll are per-QP stagingn (staged at QPCTX_COMMIT)
+    output reg        cfg_repost_wqe,
+    output reg        cfg_write_payload,
+    output reg        cfg_complete_on_send,
+    output reg [31:0] cfg_reply_to,
+    output reg        cfg_reply_poll,
+
+    // REPLY CONFIG
+    output reg [C_M_AXI_ADDR_WIDTH-1:0] cfg_reply_buf,
+    output reg [                  31:0] cfg_reply_seq_off,    // seq_num's byte offset in a slot
+    output reg [                   5:0] cfg_reply_stride_log2,
+
+    // WQE BUILD
+    output reg [                1:0] wqe_opcode,
+    output reg [               31:0] wqe_xfer_bytes,
+    output reg [               31:0] wqe_rkey,
+    output reg [               31:0] wqe_va_lsb,
+    output reg [               31:0] wqe_va_msb,
+    output reg [               63:0] wqe_local_offset,
+    output reg [               15:0] wqe_wrid,
+    output reg                       wqe_build,         // W1P on a COMMIT write.
+    output reg [C_WQE_IDX_WIDTH-1:0] wqe_build_idx,
+    output reg [C_WQE_IDX_WIDTH-1:0] cfg_run_wqe_idx,
+
+    // Timer configuration (TODO: unused for now)
+    output reg [C_QP_IDX_WIDTH-1:0] cfg_timer_qp_sel,
+
+    // QP-context build/commit
+    output reg                       ctx_build,         // W1P: QPCTX_COMMIT
+    output reg [C_CTX_IDX_WIDTH-1:0] ctx_build_idx,
+    output reg                       ctx_rebind,        // W1P w/ ctx_build
+
+    // WQE ring config
+    output reg                       wqe_buf_ring_en,
+    output reg [               15:0] wqe_buf_ring_len,
+    output reg [                5:0] wqe_stride_local_log2,
+    output reg [                5:0] wqe_stride_remote_log2,
+    output reg [C_CTX_IDX_WIDTH-1:0] wqe_qp_ref,
+
+    // per-WQE ring index reset
+    output reg                       buf_ring_reset,     // W1P: RING_RESET
+    output reg [C_WQE_IDX_WIDTH-1:0] buf_ring_reset_idx,
+
+    // demo registers
+    output reg [31:0]                command_count,
+    output reg                       start_demo,
+    output reg                       reset_demo,
+    output reg [63:0]                freq_num,
+    input wire [31:0]                sts1_demo_err,
+    input wire                       demo_sts_done,
+    output reg [31:0]                demo_syn_depth,
+    output reg [31:0]                demo_freq_span,
+    output reg [31:0]                demo_lfsr_seed,
+
+    // demo RTT trace
+    output reg                       trace_clear,
+    input wire [31:0]                sts_trace_cnt,
+    input wire                       sts_trace_full,
+    input wire                       sts_trace_sat
+);
+
+    localparam [7:0]
+        REG_CTRL          = 8'h00,
+        REG_STATUS        = 8'h04,
+        REG_QP_NUM        = 8'h08,
+        REG_PAY_LEN       = 8'h0C,
+        REG_PATTERN       = 8'h10,
+        REG_DBUF_LO       = 8'h14,
+        REG_DBUF_HI       = 8'h18,
+        REG_SQBASE_LO     = 8'h1C,
+        REG_SQBASE_HI     = 8'h20,
+        REG_SQ_DEPTH      = 8'h24,
+        REG_FLAGS         = 8'h28,
+        REG_REPLY_TO      = 8'h30,
+        REG_ROUND_CNT     = 8'h34,
+        REG_RTT_LO        = 8'h38,
+        REG_RTT_HI        = 8'h3C,
+        REG_WQE_OPCODE    = 8'h40,
+        REG_WQE_XFER_LEN  = 8'h44,
+        REG_WQE_RKEY      = 8'h48,
+        REG_WQE_VA_LO     = 8'h4C,
+        REG_WQE_VA_HI     = 8'h50,
+        REG_WQE_OFFS_LO   = 8'h54,
+        REG_WQE_OFFS_HI   = 8'h58,
+        REG_WQE_WRID      = 8'h5C,
+        REG_WQE_COMMIT    = 8'h60,
+        REG_RUN_WQE_IDX   = 8'h64,
+        REG_TIMER_QP_SEL  = 8'h68,
+        REG_REPLY_BUF_LO  = 8'h6C,
+        REG_REPLY_BUF_HI  = 8'h70,
+        REG_REPLY_SEQ_OFF = 8'h74,
+        REG_LAST_RD       = 8'h78,
+        REG_QPCTX_COMMIT  = 8'h7C,
+        REG_WQE_QP_REF    = 8'h84,
+        REG_WQE_RING_CFG  = 8'h88,
+        REG_WQE_RING_LEN  = 8'h8C,
+        REG_RING_RESET    = 8'h90,
+        REG_REPLY_RING    = 8'h94, // [5:0]=reply_stride_log2 (reply slot = buf_ring_idx)
+        REG_DEMO_CTRL     = 8'hA8,
+        REG_FREQ_LO       = 8'hAC,
+        REG_FREQ_HI       = 8'hB0,
+        REG_DEMO_STS      = 8'hB4,
+        REG_CMD_CNT       = 8'hB8,
+        REG_STS1          = 8'hBC,
+        REG_DEMO_CTRL_2   = 8'hC0,
+        REG_FREQ_SPAN     = 8'hC4,
+        REG_LFSR_SEED     = 8'hC8,
+        REG_TRACE_CTRL    = 8'hCC,
+        REG_TRACE_CNT     = 8'hD0,
+        REG_TRACE_STS     = 8'hD4;
+
+    // ------------------------------------------------------
+    // Write channel
+    // ------------------------------------------------------
+    reg aw_done, w_done;
+    wire                          wr_fire = aw_done && w_done;
+    reg  [C_S_AXI_ADDR_WIDTH-1:0] awaddr_q;
+    reg  [                  31:0] wdata_q;
+
+    always @(posedge s_axi_aclk) begin
+        if (!s_axi_aresetn) begin
+            s_axi_awready          <= 1'b0;
+            s_axi_wready           <= 1'b0;
+            s_axi_bvalid           <= 1'b0;
+            s_axi_bresp            <= 2'b00;
+            aw_done                <= 1'b0;
+            w_done                 <= 1'b0;
+            start_tgl              <= 1'b0;
+            abort                  <= 1'b0;
+            soft_reset             <= 1'b0;
+            cfg_qp_num             <= {C_QP_IDX_WIDTH{1'b0}};
+            cfg_payload_len        <= 13'd64;
+            cfg_pattern            <= 32'hDEAD_BEEF;  // Fixed pattern for demo.
+            cfg_data_buf           <= {C_M_AXI_ADDR_WIDTH{1'b0}};
+            cfg_sq_base            <= {C_M_AXI_ADDR_WIDTH{1'b0}};
+            cfg_sq_depth           <= 16'd16;
+            cfg_repost_wqe         <= 1'b1;
+            cfg_write_payload      <= 1'b0;
+            cfg_complete_on_send   <= 1'b0;
+            cfg_reply_to           <= 32'd5000;  // 5000 core cycles for reply timeout
+
+            // reply config
+            cfg_reply_poll         <= 1'b0;
+            cfg_reply_buf          <= {C_M_AXI_ADDR_WIDTH{1'b0}};
+            cfg_reply_seq_off      <= 32'd0;
+            cfg_reply_stride_log2  <= 6'd0;
+
+            // wqe build/commit
+            wqe_opcode             <= 2'b00;
+            wqe_xfer_bytes         <= 32'd64;  // 64 bytes for the payload
+            wqe_rkey               <= 32'd0;
+            wqe_va_lsb             <= 32'd0;
+            wqe_va_msb             <= 32'd0;
+            wqe_local_offset       <= 64'd0;
+            wqe_wrid               <= 16'd0;
+            wqe_build              <= 1'b0;
+            wqe_build_idx          <= {C_WQE_IDX_WIDTH{1'b0}};
+            cfg_run_wqe_idx        <= {C_WQE_IDX_WIDTH{1'b0}};
+            cfg_timer_qp_sel       <= {C_QP_IDX_WIDTH{1'b0}};  // TODO: unused for now
+
+            // QP-context build/commit
+            ctx_build              <= 1'b0;
+            ctx_build_idx          <= {C_CTX_IDX_WIDTH{1'b0}};
+            ctx_rebind             <= 1'b0;
+
+            // WQE ring config
+            wqe_buf_ring_en        <= 1'b0;
+            wqe_buf_ring_len       <= 16'd0;
+            wqe_stride_local_log2  <= 6'd0;
+            wqe_stride_remote_log2 <= 6'd0;
+            wqe_qp_ref             <= {C_CTX_IDX_WIDTH{1'b0}};
+            buf_ring_reset         <= 1'b0;
+            buf_ring_reset_idx     <= {C_WQE_IDX_WIDTH{1'b0}};
+
+            command_count          <= 32'd1;
+            start_demo             <= 1'b0;
+            reset_demo             <= 1'b0;
+            freq_num               <= 64'd0;
+            demo_syn_depth         <= 32'd256;
+            demo_freq_span         <= 32'd0;    // no jitter unless asked for
+            demo_lfsr_seed         <= 32'd0;
+            trace_clear            <= 1'b1;
+        end else begin
+            wqe_build      <= 1'b0;
+            ctx_build      <= 1'b0;
+            ctx_rebind     <= 1'b0;
+            buf_ring_reset <= 1'b0;
+
+            // Latch AW into awaddr_q
+            if (s_axi_awvalid && !aw_done) begin
+                s_axi_awready <= 1'b1;
+                awaddr_q      <= s_axi_awaddr;
+                aw_done       <= 1'b1;
+            end else begin
+                s_axi_awready <= 1'b0;
+            end
+
+            // Latch W into wdata_q
+            if (s_axi_wvalid && !w_done) begin
+                s_axi_wready <= 1'b1;
+                wdata_q      <= s_axi_wdata;
+                w_done       <= 1'b1;
+            end else begin
+                s_axi_wready <= 1'b0;
+            end
+
+            // Commit write when both AW and W captured and no pending B
+            if (wr_fire && !s_axi_bvalid) begin
+                s_axi_bvalid <= 1'b1;
+                s_axi_bresp  <= 2'b00;  // OKAY
+                aw_done      <= 1'b0;
+                w_done       <= 1'b0;
+                case (awaddr_q[7:2])
+                    REG_CTRL[7:2]: begin
+                        if (wdata_q[0]) start_tgl <= ~start_tgl;  // W1P start
+                        abort      <= wdata_q[1];
+                        soft_reset <= wdata_q[2];
+                    end
+                    REG_QP_NUM[7:2]: cfg_qp_num <= wdata_q[C_QP_IDX_WIDTH-1:0];
+                    REG_PAY_LEN[7:2]: cfg_payload_len <= wdata_q[12:0];
+                    REG_PATTERN[7:2]: cfg_pattern <= wdata_q;
+                    REG_DBUF_LO[7:2]: cfg_data_buf[31:0] <= wdata_q;
+                    REG_DBUF_HI[7:2]:
+                    cfg_data_buf[C_M_AXI_ADDR_WIDTH-1:32] <= wdata_q[C_M_AXI_ADDR_WIDTH-32-1:0];
+                    REG_SQBASE_LO[7:2]: cfg_sq_base[31:0] <= wdata_q;
+                    REG_SQBASE_HI[7:2]:
+                    cfg_sq_base[C_M_AXI_ADDR_WIDTH-1:32] <= wdata_q[C_M_AXI_ADDR_WIDTH-32-1:0];
+                    REG_SQ_DEPTH[7:2]: cfg_sq_depth <= wdata_q[15:0];
+                    REG_FLAGS[7:2]: begin
+                        cfg_repost_wqe       <= wdata_q[0];
+                        cfg_write_payload    <= wdata_q[1];
+                        cfg_complete_on_send <= wdata_q[2];
+                        cfg_reply_poll       <= wdata_q[3];
+                    end
+                    REG_REPLY_TO[7:2]: cfg_reply_to <= wdata_q;
+                    REG_WQE_OPCODE[7:2]: wqe_opcode <= wdata_q[1:0];
+                    REG_WQE_XFER_LEN[7:2]: wqe_xfer_bytes <= wdata_q;
+                    REG_WQE_RKEY[7:2]: wqe_rkey <= wdata_q;
+                    REG_WQE_VA_LO[7:2]: wqe_va_lsb <= wdata_q;
+                    REG_WQE_VA_HI[7:2]: wqe_va_msb <= wdata_q;
+                    REG_WQE_OFFS_LO[7:2]: wqe_local_offset[31:0] <= wdata_q;
+                    REG_WQE_OFFS_HI[7:2]: wqe_local_offset[63:32] <= wdata_q;
+                    REG_WQE_WRID[7:2]: wqe_wrid <= wdata_q[15:0];
+
+                    REG_WQE_COMMIT[7:2]: begin
+                        wqe_build          <= 1'b1;
+                        wqe_build_idx      <= wdata_q[C_WQE_IDX_WIDTH-1:0];
+                        buf_ring_reset     <= 1'b1;
+                        buf_ring_reset_idx <= wdata_q[C_WQE_IDX_WIDTH-1:0];
+                    end
+                    REG_RUN_WQE_IDX[7:2]: cfg_run_wqe_idx <= wdata_q[C_WQE_IDX_WIDTH-1:0];
+
+                    // WQE ring config (staged; committed with WQE_COMMIT)
+                    REG_WQE_QP_REF[7:2]: wqe_qp_ref <= wdata_q[C_CTX_IDX_WIDTH-1:0];
+
+                    REG_WQE_RING_CFG[7:2]: begin
+                        wqe_buf_ring_en        <= wdata_q[0];
+                        wqe_stride_local_log2  <= wdata_q[13:8];
+                        wqe_stride_remote_log2 <= wdata_q[21:16];
+                    end
+                    REG_WQE_RING_LEN[7:2]: wqe_buf_ring_len <= wdata_q[15:0];
+
+                    // QP-context commit
+                    REG_QPCTX_COMMIT[7:2]: begin
+                        ctx_build     <= 1'b1;
+                        ctx_build_idx <= wdata_q[C_CTX_IDX_WIDTH-1:0];
+                        ctx_rebind    <= wdata_q[31];
+                    end
+
+                    // WQE ring resete
+                    REG_RING_RESET[7:2]: begin
+                        buf_ring_reset     <= 1'b1;
+                        buf_ring_reset_idx <= wdata_q[C_WQE_IDX_WIDTH-1:0];
+                    end
+                    REG_TIMER_QP_SEL[7:2]: cfg_timer_qp_sel <= wdata_q[C_QP_IDX_WIDTH-1:0];
+                    REG_REPLY_BUF_LO[7:2]: cfg_reply_buf[31:0] <= wdata_q;
+                    REG_REPLY_BUF_HI[7:2]:
+                    cfg_reply_buf[C_M_AXI_ADDR_WIDTH-1:32] <= wdata_q[C_M_AXI_ADDR_WIDTH-32-1:0];
+                    REG_REPLY_SEQ_OFF[7:2]: cfg_reply_seq_off <= wdata_q;
+                    REG_REPLY_RING[7:2]: cfg_reply_stride_log2 <= wdata_q[5:0];
+                    REG_DEMO_CTRL[7:2]: begin
+                        if (wdata_q[0]) start_demo <= ~start_demo;  // W1P start
+                        reset_demo <= wdata_q[1];
+                    end
+                    REG_DEMO_CTRL_2[7:2]: demo_syn_depth <= wdata_q[31:0];
+                    REG_FREQ_LO[7:2]: freq_num[31:0] <= wdata_q;
+                    REG_FREQ_HI[7:2]: freq_num[63:32] <= wdata_q;
+                    REG_CMD_CNT[7:2]:command_count <= wdata_q[31:0];
+                    REG_FREQ_SPAN[7:2]: demo_freq_span <= wdata_q[31:0];
+                    REG_LFSR_SEED[7:2]: demo_lfsr_seed <= wdata_q[31:0];
+                    REG_TRACE_CTRL[7:2]: trace_clear <= wdata_q[0];
+                    default: ;  // Unmapped writes ignored (BRESP is OKAY)
+                endcase
+            end else if (s_axi_bvalid && s_axi_bready) begin
+                s_axi_bvalid <= 1'b0;
+            end
+        end
+    end
+
+    // ------------------------------------------------------
+    // Read channel
+    // ------------------------------------------------------
+    reg [C_S_AXI_ADDR_WIDTH-1:0] araddr_q;
+    always @(posedge s_axi_aclk) begin
+        if (!s_axi_aresetn) begin
+            s_axi_arready <= 1'b0;
+            s_axi_rvalid  <= 1'b0;
+            s_axi_rresp   <= 2'b00;
+            s_axi_rdata   <= 32'd0;
+        end else begin
+            if (s_axi_arvalid && !s_axi_arready && !s_axi_rvalid) begin
+                s_axi_arready <= 1'b1;
+                araddr_q      <= s_axi_araddr;
+            end else begin
+                s_axi_arready <= 1'b0;
+            end
+
+            if (s_axi_arready) begin
+                s_axi_rvalid <= 1'b1;
+                s_axi_rresp  <= 2'b00;
+                case (araddr_q[7:2])
+                    REG_CTRL[7:2]: s_axi_rdata <= {29'd0, soft_reset, abort, 1'b0};
+                    REG_STATUS[7:2]:
+                    s_axi_rdata <= {
+                        23'd0,
+                        sts_axi_err,
+                        sts_timeout,
+                        sts_reply_seen,
+                        sts_done,
+                        sts_busy,
+                        sts_state
+                    };
+                    REG_QP_NUM[7:2]: s_axi_rdata <= {{(32 - C_QP_IDX_WIDTH) {1'b0}}, cfg_qp_num};
+                    REG_PAY_LEN[7:2]: s_axi_rdata <= {19'd0, cfg_payload_len};
+                    REG_PATTERN[7:2]: s_axi_rdata <= cfg_pattern;
+                    REG_DBUF_LO[7:2]: s_axi_rdata <= cfg_data_buf[31:0];
+                    REG_DBUF_HI[7:2]: s_axi_rdata <= cfg_data_buf[C_M_AXI_ADDR_WIDTH-1:32];
+                    REG_SQBASE_LO[7:2]: s_axi_rdata <= cfg_sq_base[31:0];
+                    REG_SQBASE_HI[7:2]: s_axi_rdata <= cfg_sq_base[C_M_AXI_ADDR_WIDTH-1:32];
+                    REG_SQ_DEPTH[7:2]: s_axi_rdata <= {16'd0, cfg_sq_depth};
+                    REG_FLAGS[7:2]:
+                    s_axi_rdata <= {
+                        28'd0,
+                        cfg_reply_poll,
+                        cfg_complete_on_send,
+                        cfg_write_payload,
+                        cfg_repost_wqe
+                    };
+                    REG_REPLY_TO[7:2]: s_axi_rdata <= cfg_reply_to;
+                    REG_ROUND_CNT[7:2]: s_axi_rdata <= sts_round_cnt;
+                    REG_RTT_LO[7:2]: s_axi_rdata <= sts_rtt[31:0];
+                    REG_RTT_HI[7:2]: s_axi_rdata <= sts_rtt[63:32];
+                    REG_WQE_OPCODE[7:2]: s_axi_rdata <= {30'd0, wqe_opcode};
+                    REG_WQE_XFER_LEN[7:2]: s_axi_rdata <= wqe_xfer_bytes;
+                    REG_WQE_RKEY[7:2]: s_axi_rdata <= wqe_rkey;
+                    REG_WQE_VA_LO[7:2]: s_axi_rdata <= wqe_va_lsb;
+                    REG_WQE_VA_HI[7:2]: s_axi_rdata <= wqe_va_msb;
+                    REG_WQE_OFFS_LO[7:2]: s_axi_rdata <= wqe_local_offset[31:0];
+                    REG_WQE_OFFS_HI[7:2]: s_axi_rdata <= wqe_local_offset[63:32];
+                    REG_WQE_WRID[7:2]: s_axi_rdata <= {16'd0, wqe_wrid};
+                    REG_WQE_COMMIT[7:2]:
+                    s_axi_rdata <= {{(32 - C_WQE_IDX_WIDTH) {1'b0}}, wqe_build_idx};
+                    REG_RUN_WQE_IDX[7:2]:
+                    s_axi_rdata <= {{(32 - C_WQE_IDX_WIDTH) {1'b0}}, cfg_run_wqe_idx};
+                    REG_TIMER_QP_SEL[7:2]:
+                    s_axi_rdata <= {{(32 - C_QP_IDX_WIDTH) {1'b0}}, cfg_timer_qp_sel};
+                    REG_LAST_RD[7:2]: s_axi_rdata <= sts_last_rd;
+                    REG_WQE_QP_REF[7:2]:
+                    s_axi_rdata <= {{(32 - C_CTX_IDX_WIDTH) {1'b0}}, wqe_qp_ref};
+                    REG_WQE_RING_CFG[7:2]:
+                    s_axi_rdata <= {
+                        10'd0,  // [31:22]
+                        wqe_stride_remote_log2,  // [21:16]
+                        2'd0,  // [15:14]
+                        wqe_stride_local_log2,  // [13:8]
+                        7'd0,  // [7:1]
+                        wqe_buf_ring_en  // [0]
+                    };
+                    REG_WQE_RING_LEN[7:2]: s_axi_rdata <= {16'd0, wqe_buf_ring_len};
+                    REG_REPLY_RING[7:2]: s_axi_rdata <= {26'd0, cfg_reply_stride_log2};
+                    REG_DEMO_CTRL[7:2]: s_axi_rdata <= {30'd0, reset_demo, start_demo};
+                    REG_DEMO_CTRL_2[7:2]: s_axi_rdata <= demo_syn_depth;
+                    REG_FREQ_LO[7:2]: s_axi_rdata <= freq_num[31:0];
+                    REG_FREQ_HI[7:2]: s_axi_rdata <= freq_num[63:32];
+                    REG_DEMO_STS[7:2]: s_axi_rdata <= {31'd0, demo_sts_done};
+                    REG_STS1[7:2]: s_axi_rdata <= sts1_demo_err;
+                    REG_CMD_CNT[7:2]: s_axi_rdata <= command_count;
+                    REG_FREQ_SPAN[7:2]: s_axi_rdata <= demo_freq_span;
+                    REG_LFSR_SEED[7:2]: s_axi_rdata <= demo_lfsr_seed;
+                    REG_TRACE_CTRL[7:2]: s_axi_rdata <= {31'd0, trace_clear};
+                    REG_TRACE_CNT[7:2]: s_axi_rdata <= sts_trace_cnt;
+                    REG_TRACE_STS[7:2]: s_axi_rdata <= {30'd0, sts_trace_sat, sts_trace_full};
+                    default: s_axi_rdata <= 32'd0;
+                endcase
+            end else if (s_axi_rvalid && s_axi_rready) begin
+                s_axi_rvalid <= 1'b0;
+            end
+        end
+    end
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_doorbell.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_doorbell.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_doorbell.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_doorbell.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,137 @@
+//===----------------------------------------------------------------------===//
+//
+// hh_doorbell.v
+// ERNIC doorbell-handshake adapter.
+//
+// It owns three independent doorbell flows:
+// 1. SQ-PI ring (OUT): on `ring_req`, write the producer index to ERNIC's SQ-PI doorbell, ring_done
+// 2. Send-CQ    (IN):  ERNIC flags an outbound send completed, send_compl
+// 3. RQ-PI      (IN):  reply landed, update reply_qp, reply
+// 4. RQ-CI      (OUT): reply received. We're not using it! Because we cannot detect any signal
+//                      from ERNIC due to the hardware handshake mode set from CPU side at the
+//                      beginning. And it will crash if you unset the hardware handshake mode.
+//===----------------------------------------------------------------------===//
+`timescale 1ps / 1ps `default_nettype none
+
+
+module hh_doorbell #(
+    parameter integer        C_QP_IDX_WIDTH  = 8,
+    parameter         [31:0] XRNIC_BASE_ADDR = 32'h8400_0000
+) (
+    input wire core_clk,
+    input wire core_rstn,
+
+    // Ring SQ producer-index doorbell
+    input  wire                      ring_req,  // W1P
+    input  wire [C_QP_IDX_WIDTH-1:0] ring_qp,   // ERNIC QP number
+    input  wire [              15:0] ring_pi,   // SQ producer index
+    output reg                       ring_done, // 1-cycle pulse when accepted
+
+    // Orchestrator events
+    output reg                      send_compl,  // 1-cycle: outbound send completed
+    output reg                      reply,       // 1-cycle: reply received on RQ
+    output reg [C_QP_IDX_WIDTH-1:0] reply_qp,
+
+    // ERNIC SQ-PI doorbell (OUT)
+    output reg  [15:0] o_qp_sq_pidb_data,
+    output reg  [31:0] o_qp_sq_pidb_wr_addr,
+    output reg         o_qp_sq_pidb_wr_valid,
+    input  wire        i_qp_sq_pidb_wr_rdy,
+
+    // ERNIC send-CQ doorbell (IN)
+    input  wire        i_send_cq_db_cnt_valid,
+    input  wire [12:0] i_send_cq_db_addr,
+    input  wire [31:0] i_send_cq_db_cnt,
+    output reg         o_send_cq_db_rdy,
+
+    // ERNIC RQ-PI doorbell (IN)
+    input  wire        i_rq_pi_db_vld,
+    input  wire [12:0] i_rq_pi_db_addr,
+    input  wire [31:0] i_rq_pi_db_data,
+    output reg         o_rq_pi_db_rdy,
+
+    // ERNIC RQ-CI doorbell (OUT)
+    output reg         o_rq_ci_db_vld,
+    output reg  [31:0] o_rq_ci_db_addr,
+    output reg  [15:0] o_rq_ci_db_data,
+    input  wire        i_rq_ci_db_rdy
+);
+
+    // ------------------------------------------------------------------
+    // 1. SQ-PI ring
+    // ------------------------------------------------------------------
+    // addr = XRNIC_BASE + 0x180038 + (qp * 0x100)  (per-QP stride 0x100)
+    localparam [31:0] SQ_PIDB_BASE = 32'h0018_0038;
+
+    always @(posedge core_clk) begin
+        if (!core_rstn) begin
+            o_qp_sq_pidb_wr_valid <= 1'b0;
+            o_qp_sq_pidb_wr_addr  <= 32'd0;
+            o_qp_sq_pidb_data     <= 16'd0;
+            ring_done             <= 1'b0;
+        end else begin
+            ring_done <= 1'b0;
+            if (ring_req && !o_qp_sq_pidb_wr_valid) begin
+                o_qp_sq_pidb_wr_valid <= 1'b1;
+                o_qp_sq_pidb_data <= ring_pi;
+                o_qp_sq_pidb_wr_addr  <= (XRNIC_BASE_ADDR + SQ_PIDB_BASE)
+                                          + ({{(32-C_QP_IDX_WIDTH){1'b0}}, ring_qp} << 8);
+            end else if (o_qp_sq_pidb_wr_valid && i_qp_sq_pidb_wr_rdy) begin
+                o_qp_sq_pidb_wr_valid <= 1'b0;
+                ring_done             <= 1'b1;
+            end
+        end
+    end
+
+    // ------------------------------------------------------------------
+    // 2. Send-CQ doorbell drain
+    // ------------------------------------------------------------------
+    always @(posedge core_clk) begin
+        if (!core_rstn) begin
+            o_send_cq_db_rdy <= 1'b0;
+            send_compl       <= 1'b0;
+        end else begin
+            send_compl <= 1'b0;
+            if (i_send_cq_db_cnt_valid && !o_send_cq_db_rdy) begin
+                o_send_cq_db_rdy <= 1'b1;  // ack
+                send_compl       <= 1'b1;
+            end else begin
+                o_send_cq_db_rdy <= 1'b0;
+            end
+        end
+    end
+
+    // ------------------------------------------------------------------
+    // 3. RQ producer-index doorbell
+    // ------------------------------------------------------------------
+    always @(posedge core_clk) begin
+        if (!core_rstn) begin
+            o_rq_pi_db_rdy <= 1'b0;
+            reply          <= 1'b0;
+            reply_qp       <= {C_QP_IDX_WIDTH{1'b0}};
+        end else begin
+            reply          <= 1'b0;  // W1P
+            o_rq_pi_db_rdy <= 1'b0;  // W1P
+            if (i_rq_pi_db_vld && !o_rq_pi_db_rdy) begin
+                o_rq_pi_db_rdy <= 1'b1;  // ack the RQ-PI doorbell
+                reply          <= 1'b1;  // reply landed
+                reply_qp       <= i_rq_pi_db_addr[2+:C_QP_IDX_WIDTH];
+            end
+        end
+    end
+
+    always @(posedge core_clk) begin
+        if (!core_rstn) begin
+            o_rq_ci_db_vld  <= 1'b0;
+            o_rq_ci_db_addr <= 32'd0;
+            o_rq_ci_db_data <= 16'd0;
+        end else begin
+            o_rq_ci_db_vld  <= 1'b0;  // never write back the RQ CI under HW-HS
+            o_rq_ci_db_addr <= 32'd0;
+            o_rq_ci_db_data <= 16'd0;
+        end
+    end
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_macros.vh b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_macros.vh
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_macros.vh	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_macros.vh	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,28 @@
+// Common helpers for the hardware handshake IP.
+
+// WQE word (64B):
+// - bytes 0-31 are the ERNIC descriptor
+// - bytes 32-63 (bits [511:256]) carry engine-only ring config + qp_ref
+// verilog_format: off
+`ifndef HH_CFG_LSB
+`define HH_CFG_LSB           256
+`define HH_CFG_RING_EN       (`HH_CFG_LSB + 0)    // [256]     1b (rings LADDR+ROFFSET+reply)
+                                                  // [258:257] reserved
+`define HH_CFG_RING_LEN_LSB  (`HH_CFG_LSB + 3)    // [274:259] 16b
+`define HH_CFG_SLL_LSB       (`HH_CFG_LSB + 19)   // [280:275] 6b  stride_local_log2
+`define HH_CFG_SRL_LSB       (`HH_CFG_LSB + 25)   // [286:281] 6b  stride_remote_log2
+`define HH_CFG_QPREF_LSB     (`HH_CFG_LSB + 31)   // [.. ]     qp_ref (C_CTX_IDX_WIDTH bits)
+`endif
+// verilog_format: on
+
+// log2 ceiling helper for Verilog-2001 parameter/localparam calculations.
+function integer clog2;
+    input integer v;
+    integer i;
+    begin
+        clog2 = 0;
+        for (i = v - 1; i > 0; i = i >> 1) begin
+            clog2 = clog2 + 1;
+        end
+    end
+endfunction
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_orchestrator.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_orchestrator.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_orchestrator.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_orchestrator.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,537 @@
+//===----------------------------------------------------------------------===//
+//
+// hh_orchestrator.v
+// The control FSM for one HH RDMA round:
+//
+// IDLE --start-->
+//    WQE     post the 64B WQE; t_start here (rtt)
+//    RING    ring SQ PI doorbell; advance the ring slot and the round sequence
+//    WAIT    wait for the send to be consumed (reply-poll), or for the
+//            reply / send-CQ (other modes), or timeout
+//    POLL    read the reply slot until its seq_num is this round's
+//            (skipped if qpc_reply_poll is not set)
+//    JOIN    wait for the background WQE repost and completion to finish
+//    NEXT    latch rtt (= free_cnt - t_start), raise done
+//
+//===----------------------------------------------------------------------===//
+`default_nettype none `timescale 1ps / 1ps
+
+module hh_orchestrator #(
+    parameter integer C_M_AXI_ADDR_WIDTH = 64,
+    parameter integer C_M_AXI_DATA_WIDTH = 512,
+    parameter integer C_QP_IDX_WIDTH     = 8,
+    parameter integer C_WQE_IDX_WIDTH    = 4,
+    parameter integer C_CTX_IDX_WIDTH    = 3,
+    // RTT TRACE depth: 20 -> 1,048,576 entries = 2 MB
+    parameter integer C_TRACE_AW         = 20
+) (
+    input wire core_clk,
+    input wire core_rstn,
+    input wire start_demo,
+
+    // CONTROL
+    input wire start_pulse,  // W1P
+    input wire abort,        // Level
+
+    // CONFIG
+    input wire [C_M_AXI_DATA_WIDTH-1:0] wqe_data,          // selected WQE
+    input wire [   C_WQE_IDX_WIDTH-1:0] cfg_run_wqe_idx,
+    input wire                          wqe_build,
+    input wire [   C_WQE_IDX_WIDTH-1:0] wqe_build_idx,
+    input wire [    C_QP_IDX_WIDTH-1:0] cfg_timer_qp_sel,  // TODO: unused
+    input wire                          cfg_repost_wqe,
+
+    // AXI4-Stream Master - RX path
+    input  wire         m_axis_clk,
+    input  wire         m_axis_aresetn,
+    output reg  [511:0]m_axis_tdata,
+    output reg         m_axis_tvalid,
+    input  wire         m_axis_tready,
+    output wire         m_axis_tlast,    // Tied high for single-beat packets
+
+    // AXI4-Stream Slave - TX path
+    input  wire         s_axis_clk,
+    input  wire         s_axis_aresetn,
+    input  wire [511:0] s_axis_tdata,
+    input  wire         s_axis_tvalid,
+    output reg          s_axis_tready,
+    input  wire         s_axis_tlast,    // Ignored in this single-beat logic
+
+    // Write DMA
+    output reg                           dma_req,
+    output reg  [C_M_AXI_ADDR_WIDTH-1:0] dma_addr,
+    output reg  [                   8:0] dma_beats,
+    output reg  [C_M_AXI_DATA_WIDTH-1:0] dma_fill,
+    input  wire                          dma_busy,
+    input  wire                          dma_done,
+    input  wire                          dma_err,
+
+    // Reply slot and data
+    output wire [                  15:0] reply_slot_o,
+    input  wire [C_M_AXI_DATA_WIDTH-1:0] rd_data,
+
+    // Doorbell
+    output reg                       ring_req,
+    output reg  [C_QP_IDX_WIDTH-1:0] ring_qp,
+    output reg  [              15:0] ring_pi,
+    input  wire                      ring_done,
+    input  wire                      send_compl,
+    input  wire                      reply,
+    input  wire [C_QP_IDX_WIDTH-1:0] reply_qp,
+
+    // QP-context table: read active ctx by qp_ref; advance its sq_pi at RING
+    output wire [   C_CTX_IDX_WIDTH-1:0] qpc_rd_ctx,
+    input  wire [    C_QP_IDX_WIDTH-1:0] qpc_qp_num,
+    input  wire [C_M_AXI_ADDR_WIDTH-1:0] qpc_sq_base,
+    input  wire [                  15:0] qpc_sq_depth,
+    input  wire [                  15:0] qpc_sq_pi,
+    input  wire                          qpc_complete_on_send,   // TODO: unused
+    input  wire                          qpc_reply_poll,
+    input  wire [                  31:0] qpc_reply_to,
+    input  wire [                  31:0] qpc_reply_seq_off,
+    input  wire [                   5:0] qpc_reply_stride_log2,  // reply ring: slot = buf_ring_idx
+    output reg                           qpc_adv,
+    output wire [   C_CTX_IDX_WIDTH-1:0] qpc_adv_idx,
+
+    // ring-index table: read active WQE's buf_ring_idx + round sequence, advance both at RING
+    output wire [C_WQE_IDX_WIDTH-1:0] buf_ring_rd_idx,
+    input  wire [               15:0] buf_ring_idx,
+    input  wire [               31:0] buf_ring_seq,
+    output reg                        buf_ring_adv,
+    output reg                        buf_ring_seq_adv,
+    output wire [C_WQE_IDX_WIDTH-1:0] buf_ring_adv_idx,
+    output wire [               15:0] buf_ring_adv_len,
+
+    // STATUS
+    output reg [ 3:0] sts_state,
+    output reg        sts_busy,
+    output reg        sts_done,
+    output reg        sts_timeout,
+    output reg        sts_axi_err,
+    output reg        sts_reply_seen,
+    output reg [31:0] sts_round_cnt,
+    output reg [63:0] sts_rtt,
+    output reg [31:0] sts_last_rd,     // DEBUG: last 32b the reply-poll READ returned
+    output reg        sts_update,      // toggles each completed round
+
+    // DEMO RTT TRACE
+    input  wire                   trace_clear,    // level: hold the trace empty
+    output reg                    trace_we,
+    output reg  [ C_TRACE_AW-1:0] trace_addr,
+    output reg  [           15:0] trace_din,      // rtt in clocks, saturating
+    output reg  [           31:0] sts_trace_cnt,  // rtt entries written
+    output reg                    sts_trace_full, // rtt pointer hit the end
+    output reg                    sts_trace_sat   // rtt sticky: some round exceeded 16 bits
+);
+
+    `include "hh_macros.vh"
+
+    localparam [3:0] S_IDLE          = 4'd0,
+                     S_WQE_ISS       = 4'd1,
+                     S_WQE_WAIT      = 4'd2,
+                     S_DAT_WAIT      = 4'd3,
+                     S_DAT_ISS       = 4'd4,
+                     S_RING_ISS      = 4'd5,
+                     S_RING_WAIT     = 4'd6,
+                     S_WAIT_RPL      = 4'd7,
+                     S_NEXT          = 4'd8,
+                     S_DAT_IDLE      = 4'd9,
+                     S_DAT_TX_ISS    = 4'd10,
+                     S_DAT_TX_WAIT   = 4'd11,
+                     // 4'd12 ~ 4'd13 are reserved
+                     S_POLL_WAIT     = 4'd14,
+                     S_JOIN          = 4'd15;
+
+    reg [3:0] state;
+    reg [63:0] free_cnt;
+    reg [63:0] t_start;
+    reg [31:0] to_cnt;
+    reg send_seen;  // latched send_compl seen this round
+
+    reg posted_valid;  // a WQE is already pre-posted in the next-to-ring slot
+    reg [C_WQE_IDX_WIDTH-1:0] posted_idx;  // which WQE index that pre-post was for
+    reg repost_busy;  // background repost write DMA in flight this round
+    reg round_ok;  // this round completed cleanly (vs timed out)
+    reg prepost_stale;
+    reg [15:0] reply_slot;  // reply ring: this round's slot, latched before buf_ring_idx advances
+
+    localparam integer BEAT_BYTES = C_M_AXI_DATA_WIDTH / 8;
+    localparam integer BEAT_LSB = clog2(BEAT_BYTES);  // 512b bus -> 64B/beat -> 6
+    localparam integer DW_LSB = 2;                    // a dword is 4B
+
+    wire [BEAT_LSB-DW_LSB-1:0] seq_dw = qpc_reply_seq_off[BEAT_LSB-1:DW_LSB];
+    wire [               31:0] rd_seq = rd_data[seq_dw*32+:32];
+
+    // Unpack the selected WQE's engine-side config
+    wire buf_ring_en = wqe_data[`HH_CFG_RING_EN];
+    wire [15:0] buf_ring_len = wqe_data[`HH_CFG_RING_LEN_LSB+:16];
+    wire [5:0] sll = wqe_data[`HH_CFG_SLL_LSB+:6];  // stride_local_log2
+    wire [5:0] srl = wqe_data[`HH_CFG_SRL_LSB+:6];  // stride_remote_log2
+    wire [C_CTX_IDX_WIDTH-1:0] qp_ref = wqe_data[`HH_CFG_QPREF_LSB+:C_CTX_IDX_WIDTH];
+
+    // Table read/advance wiring:
+    assign qpc_rd_ctx       = qp_ref;
+    assign qpc_adv_idx      = qp_ref;
+    assign buf_ring_rd_idx  = cfg_run_wqe_idx;
+    assign buf_ring_adv_idx = cfg_run_wqe_idx;
+    assign buf_ring_adv_len = buf_ring_len;
+
+    // Patch the SQ's WQE that is actually sent to ERNIC.
+    wire [                  63:0] base_laddr = wqe_data[12*8-1 : 4*8];
+    wire [                  63:0] base_roff = wqe_data[28*8-1 : 20*8];
+    wire [                  63:0] local_off = buf_ring_en ? ({48'd0, buf_ring_idx} << sll) : 64'd0;
+    wire [                  63:0] remote_off = buf_ring_en ? ({48'd0, buf_ring_idx} << srl) : 64'd0;
+    reg  [C_M_AXI_DATA_WIDTH-1:0] wqe_patched;
+    always @(*) begin
+        wqe_patched                = wqe_data;
+        wqe_patched[511:256]       = 256'd0;  // strip engine cfg
+        wqe_patched[12*8-1 : 4*8]  = base_laddr + local_off;  // LADDR
+        wqe_patched[28*8-1 : 20*8] = base_roff + remote_off;  // ROFFSET
+    end
+
+    wire [C_M_AXI_ADDR_WIDTH-1:0] payload_dma_addr = wqe_patched[95:32];
+
+    // SQ ring-slot byte address = this QP context's sq_base + sq_pi*64
+    wire [C_M_AXI_ADDR_WIDTH-1:0] sq_slot_addr =
+            qpc_sq_base + ({{(C_M_AXI_ADDR_WIDTH-16){1'b0}}, qpc_sq_pi} << 6); // *64B
+
+    assign reply_slot_o = reply_slot;
+
+    wire poll_timed_out = (qpc_reply_to != 32'd0) &&
+                          ((free_cnt - t_start) >= {32'd0, qpc_reply_to});
+
+    // A background-reposted WQE is reusable only if it is still the selected index,
+    // if the host changed cfg_run_wqe_idx since, the pre-post is stale -> re-post in-band.
+    wire pre_post_valid = posted_valid && (posted_idx == cfg_run_wqe_idx) && !prepost_stale;
+
+    // RTT trace:
+    reg                  trace_push;   // W1P -- the rtt is on trace_value
+    reg [        15:0]   trace_value;
+    reg [C_TRACE_AW-1:0] trace_ptr;
+
+    // Demo Mode Registers
+    reg demo_act;
+    reg [C_M_AXI_DATA_WIDTH-1:0] demo_payload;
+    reg [C_M_AXI_DATA_WIDTH-1:0] rd_data_d;
+
+    assign m_axis_tlast = 1'b1; // Tied high for single-beat stream packets
+
+    // This round's rtt as of S_NEXT. Reply-poll outside demo mode assigns sts_rtt in S_NEXT
+    // itself, so the register still reads as the previous round there. We compute it live instead.
+    wire [63:0] state_rtt_now = (qpc_reply_poll && !demo_act) ? (free_cnt - t_start) : sts_rtt;
+
+    always @(posedge core_clk) begin
+        free_cnt <= free_cnt + 64'd1;  // free-running; reset only at por
+        if (!core_rstn) begin
+            state          <= S_IDLE;
+            free_cnt       <= 64'd0;
+            reply_slot     <= 16'd0;
+            t_start        <= 64'd0;
+            to_cnt         <= 32'd0;
+            send_seen      <= 1'b0;
+            posted_valid   <= 1'b0;
+            posted_idx     <= {C_WQE_IDX_WIDTH{1'b0}};
+            repost_busy    <= 1'b0;
+            round_ok       <= 1'b0;
+            prepost_stale  <= 1'b0;
+            dma_req        <= 1'b0;
+            dma_addr       <= {C_M_AXI_ADDR_WIDTH{1'b0}};
+            dma_beats      <= 9'd0;
+            dma_fill       <= {C_M_AXI_DATA_WIDTH{1'b0}};
+            ring_req       <= 1'b0;
+            ring_qp        <= {C_QP_IDX_WIDTH{1'b0}};
+            ring_pi        <= 16'd0;
+            qpc_adv          <= 1'b0;
+            buf_ring_adv     <= 1'b0;
+            buf_ring_seq_adv <= 1'b0;
+            sts_state      <= S_IDLE;
+            sts_busy       <= 1'b0;
+            sts_done       <= 1'b0;
+            sts_timeout    <= 1'b0;
+            sts_axi_err    <= 1'b0;
+            sts_reply_seen <= 1'b0;
+            sts_round_cnt  <= 32'd0;
+            sts_rtt        <= 64'd0;
+            sts_last_rd    <= 32'd0;
+            sts_update     <= 1'b0;
+            demo_act       <= 1'b0;
+            trace_push     <= 1'b0;
+            trace_value    <= 16'd0;
+            s_axis_tready  <= 1'b0;
+            m_axis_tvalid  <= 1'b0;
+            m_axis_tdata   <= {C_M_AXI_DATA_WIDTH{1'b0}};
+        end else begin
+            dma_req          <= 1'b0;  // 1-cycle request strobes; re-asserted by each *_ISS
+            ring_req         <= 1'b0;
+            qpc_adv          <= 1'b0;
+            buf_ring_adv     <= 1'b0;
+            buf_ring_seq_adv <= 1'b0;
+            s_axis_tready    <= 1'b0;
+            m_axis_tvalid    <= 1'b0;
+            trace_push       <= 1'b0;
+            sts_state        <= state;
+            if (dma_err) sts_axi_err <= 1'b1;
+
+            // background watcher: clear repost_busy when its write DMA finishes
+            if (repost_busy && dma_done) repost_busy <= 1'b0;
+
+            // The staged WQE becomes stale once a WQE_COMMIT rewrites the pre-posted WQE's desc.
+            // The next round will re-post in-band with the new WQE.
+            if (wqe_build && (wqe_build_idx == posted_idx)) prepost_stale <= 1'b1;
+
+            if (abort && state != S_IDLE) begin
+                state          <= S_IDLE;
+                sts_busy       <= 1'b0;
+                sts_done       <= 1'b0;
+                sts_timeout    <= 1'b0;
+                sts_reply_seen <= 1'b0;
+                posted_valid   <= 1'b0;  // ring state uncertain -> force a fresh post
+                repost_busy    <= 1'b0;
+                prepost_stale  <= 1'b0;
+            end else
+                case (state)
+                    S_IDLE: begin
+                        sts_busy <= 1'b0;
+                        if (start_demo && !abort) begin
+                            sts_busy       <= 1'b1;
+                            sts_done       <= 1'b0;
+                            sts_timeout    <= 1'b0;
+                            sts_axi_err    <= 1'b0;
+                            reply_slot     <= buf_ring_idx;
+                            sts_reply_seen <= 1'b0;
+                            send_seen      <= 1'b0;
+                            demo_act    <= 1'b1;
+                            state          <= S_DAT_IDLE;
+                        end
+                        else if (start_pulse && !abort) begin
+                            demo_act     <= 1'b0;
+                            sts_busy       <= 1'b1;
+                            sts_done       <= 1'b0;
+                            sts_timeout    <= 1'b0;
+                            sts_axi_err    <= 1'b0;
+                            // latch this round's reply slot = current buf_ring_idx
+                            reply_slot     <= buf_ring_idx;
+                            sts_reply_seen <= 1'b0;
+                            sts_round_cnt  <= 32'd0;
+                            send_seen      <= 1'b0;
+                            // NOTE: the SQ pointer now lives per-QP in qp_ctx's sq_pi, and
+                            // ring position per-WQE in ring_state's buf_ring_idx. Both persist
+                            // across rounds/switches.
+
+                            // Enter the pipeline
+                            state          <= S_WQE_ISS;
+                        end
+                    end
+
+                    S_DAT_IDLE: begin
+                        s_axis_tready <= 1'b1;
+
+                        if (!start_demo) begin
+                            s_axis_tready <= 1'b0;
+                            demo_act      <= 1'b0;
+                            sts_busy      <= 1'b0;
+                            state         <= S_IDLE;
+                        end
+                        else if (s_axis_tready && s_axis_tvalid) begin
+                            s_axis_tready <= 1'b0;
+                            demo_payload  <= s_axis_tdata;
+                            t_start       <= free_cnt; // Timer starts on RX handshake
+                            state         <= S_DAT_ISS;
+                        end
+                    end
+
+                    S_DAT_ISS: begin
+                        dma_req   <= 1'b1;
+                        dma_addr  <= payload_dma_addr;
+                        dma_beats <= 9'd1;
+                        dma_fill  <= demo_payload;
+
+                        // override the seq_num to the next one
+                        dma_fill[seq_dw*32+:32] <= buf_ring_seq + 32'd1;
+                        state     <= S_DAT_WAIT;
+                    end
+
+                    S_DAT_WAIT: begin
+                        if (dma_done) state <= S_WQE_ISS;
+                    end
+
+                    // ================================================================ //
+                    // per-round pipeline: WQE -> RING
+                    // ================================================================ //
+
+                    // ---------------------------------------------------------------- //
+                    // WQE: post the 64B descriptor into the SQ slot; skipped when a previous
+                    // round already reposted it (posted_valid=1)
+                    // ---------------------------------------------------------------- //
+                    S_WQE_ISS: begin
+                        if (!demo_act) begin
+                            t_start <= free_cnt;  // We start the timer here outside the demo
+                        end
+                        // re-post if no valid same-index pre-post
+                        if (cfg_repost_wqe && !pre_post_valid) begin
+                            dma_req   <= 1'b1;
+                            dma_addr  <= sq_slot_addr;
+                            dma_beats <= 9'd1;  // 64B
+                            dma_fill  <= wqe_patched;
+                            state     <= S_WQE_WAIT;
+                        end else state <= S_RING_ISS;
+                    end
+
+                    S_WQE_WAIT: if (dma_done) state <= S_RING_ISS;
+
+                    // ---------------------------------------------------------------- //
+                    // RING: ring the SQ PI doorbell
+                    // ---------------------------------------------------------------- //
+                    S_RING_ISS: begin
+                        ring_req <= 1'b1;
+                        ring_qp  <= qpc_qp_num;  // this WQE's QP (via qp_ref)
+                        ring_pi  <= qpc_sq_pi + 16'd1;
+                        state    <= S_RING_WAIT;
+                    end
+
+                    S_RING_WAIT:
+                    if (ring_done) begin
+                        qpc_adv <= 1'b1;  // advance this QP's sq_pi
+                        if (buf_ring_en) buf_ring_adv <= 1'b1;  // advance this WQE's buf_ring_idx
+                        buf_ring_seq_adv <= 1'b1;
+                        to_cnt       <= qpc_reply_to;
+                        posted_valid <= 1'b0;  // the pre-posted WQE was just consumed
+                        state        <= S_WAIT_RPL;
+                    end
+
+                    // ---------------------------------------------------------------- //
+                    // WAIT_RPL: wait for completion (reply-poll or send-CQ) or timeout
+                    // ---------------------------------------------------------------- //
+                    S_WAIT_RPL: begin
+                        if (send_compl) send_seen <= 1'b1;
+
+                        // MODE A: reply-poll: once the send is consumed, kick the S_NEXT round's
+                        //         WQE repost in the background (hides the WQE post latency),
+                        //         then go read the reply buffer in S_POLL_*.
+                        if (qpc_reply_poll) begin
+                            if (send_compl || send_seen) begin
+                                if (cfg_repost_wqe && !posted_valid && !repost_busy) begin
+                                    dma_req <= 1'b1;
+                                    dma_addr <= sq_slot_addr;  // next-to-ring slot
+                                    dma_beats <= 9'd1;  // 64B
+                                    dma_fill <= wqe_patched;  // next round's buffer
+                                    posted_idx <= cfg_run_wqe_idx;  // record which index we posted
+                                    repost_busy <= 1'b1;
+                                    prepost_stale <= 1'b0;  // fresh pre-post
+                                end
+                                state <= S_POLL_WAIT;
+                            end else if (poll_timed_out) begin
+                                sts_timeout  <= 1'b1;
+                                posted_valid <= 1'b0;  // no send -> nothing reposted
+                                round_ok     <= 1'b0;  // don't stamp rtt at S_NEXT
+                                state        <= S_NEXT;
+                            end
+                            // MODE B: non reply-poll -> complete at the send-CQ
+                        end else if (send_compl) begin
+                            sts_rtt        <= free_cnt - t_start;
+                            sts_round_cnt  <= sts_round_cnt + 32'd1;
+                            sts_reply_seen <= 1'b1;
+                            state          <= S_NEXT;
+                            // Timeout (reply_to countdown)
+                        end else if (qpc_reply_to != 32'd0) begin
+                            if (to_cnt == 32'd1) begin
+                                sts_timeout <= 1'b1;
+                                state       <= S_NEXT;
+                            end else to_cnt <= to_cnt - 32'd1;
+                        end
+                    end
+
+                    // ---------------------------------------------------------------- //
+                    // POLL: read the reply slot until its seq_num is this round's.
+                    //       An older sequence is a reply the slot still holds from a previous
+                    //       lap of the ring, which is exactly what has to be waited through.
+                    // ---------------------------------------------------------------- //
+                    S_POLL_WAIT: begin
+                        sts_last_rd <= rd_seq;  // DEBUG: the seq_num the poll read
+                        if (rd_seq == buf_ring_seq) begin
+                            sts_round_cnt  <= sts_round_cnt + 32'd1;
+                            sts_reply_seen <= 1'b1;
+                            round_ok       <= 1'b1;  // clean completion
+                            rd_data_d      <= rd_data;
+                            state          <= S_JOIN;
+                        end else if (poll_timed_out) begin
+                            sts_timeout <= 1'b1;
+                            round_ok    <= 1'b0;  // timed out -> discard the pre-post
+                            state       <= S_JOIN;
+                        end
+                    end
+
+                    // ---------------------------------------------------------------- //
+                    // JOIN: wait for the background WQE repost and completion to finish
+                    // ---------------------------------------------------------------- //
+                    S_JOIN: begin
+                        if (!repost_busy) begin
+                            posted_valid <= round_ok;
+                            if (demo_act && round_ok) begin
+                                state <= S_DAT_TX_ISS;
+                            end else begin
+                                state <= S_NEXT;
+                            end
+                        end
+                    end
+
+                    // Recieve path back to supplier
+                    S_DAT_TX_ISS: begin
+                        m_axis_tvalid <= 1'b1;
+                        m_axis_tdata  <= rd_data_d; // Forward reply data out to transport
+                        state         <= S_DAT_TX_WAIT;
+                    end
+
+                    S_DAT_TX_WAIT: begin
+                        m_axis_tvalid <= 1'b1;
+                        m_axis_tdata  <= rd_data_d;
+                        if (m_axis_tready) begin
+                            m_axis_tvalid <= 1'b0;
+                            sts_rtt       <= free_cnt - t_start; // Compute RTT after TX handshake
+                            state         <= S_NEXT;
+                        end
+                    end
+
+                    S_NEXT: begin
+                        // Stamp rtt here (round end)
+                        if (qpc_reply_poll && round_ok && !demo_act) sts_rtt <= free_cnt - t_start;
+                        // Hand over the rtt to the trace writer
+                        trace_push  <= round_ok;
+                        trace_value <= (state_rtt_now > 64'd65535) ? 16'hFFFF
+                                                                   : state_rtt_now[15:0];
+                        sts_update <= ~sts_update;
+                        sts_done   <= 1'b1;
+                        state      <= S_IDLE;
+                    end
+
+                    default: state <= S_IDLE;
+                endcase
+        end
+    end
+
+    // ------------------------------------------------------------------------------------ //
+    // RTT trace writer
+    // ------------------------------------------------------------------------------------ //
+    always @(posedge core_clk) begin
+        trace_we <= 1'b0;
+        if (!core_rstn || trace_clear) begin
+            trace_ptr      <= {C_TRACE_AW{1'b0}};
+            trace_addr     <= {C_TRACE_AW{1'b0}};
+            sts_trace_cnt  <= 32'd0;
+            sts_trace_full <= 1'b0;
+            sts_trace_sat  <= 1'b0;
+            trace_din      <= 16'd0;
+        end else if (trace_push && !sts_trace_full) begin
+            trace_we      <= 1'b1;
+            trace_addr    <= trace_ptr;
+            trace_din     <= trace_value;
+            sts_trace_cnt <= sts_trace_cnt + 32'd1;
+            if (trace_value == 16'hFFFF) sts_trace_sat <= 1'b1; // saturation flag
+            if (trace_ptr == {C_TRACE_AW{1'b1}}) sts_trace_full <= 1'b1;
+            else                                 trace_ptr <= trace_ptr + 1'b1;
+        end
+    end
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_qp_ctx.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_qp_ctx.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_qp_ctx.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_qp_ctx.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,119 @@
+//===----------------------------------------------------------------------===//
+// hh_qp_ctx.v
+//
+//   Per-QP context table:
+//       config  : qp_num, sq_base, sq_depth, reply_buf,
+//                 complete_on_send, reply_poll, reply_to,
+//                 reply_seq_off, reply_stride_log2
+//       pointer : sq_pi
+//
+//   Follow the COMMIT op, the context is committed to the table.
+//
+//===----------------------------------------------------------------------===//
+`timescale 1ps / 1ps `default_nettype none
+
+module hh_qp_ctx #(
+    parameter integer C_M_AXI_ADDR_WIDTH = 64,
+    parameter integer C_QP_IDX_WIDTH     = 8,
+    parameter integer C_NUM_CTX          = 8,
+    parameter integer C_CTX_IDX_WIDTH    = 3
+) (
+    input wire clk,
+    input wire cfg_rstn,
+    input wire core_rstn,
+
+    input wire                          ctx_build,             // W1P
+    input wire [   C_CTX_IDX_WIDTH-1:0] ctx_build_idx,
+    input wire                          ctx_rebind,            // W1P w/ ctx_build
+    input wire [    C_QP_IDX_WIDTH-1:0] ctx_qp_num,
+    input wire [C_M_AXI_ADDR_WIDTH-1:0] ctx_sq_base,
+    input wire [                  15:0] ctx_sq_depth,
+    input wire [C_M_AXI_ADDR_WIDTH-1:0] ctx_reply_buf,
+    input wire                          ctx_complete_on_send,
+    input wire                          ctx_reply_poll,
+    input wire [                  31:0] ctx_reply_to,
+    input wire [                  31:0] ctx_reply_seq_off,
+    input wire [                   5:0] ctx_reply_stride_log2,
+
+    input  wire [   C_CTX_IDX_WIDTH-1:0] rd_ctx,
+    output wire [    C_QP_IDX_WIDTH-1:0] o_qp_num,
+    output wire [C_M_AXI_ADDR_WIDTH-1:0] o_sq_base,
+    output wire [                  15:0] o_sq_depth,
+    output wire [                  15:0] o_sq_pi,
+    output wire [C_M_AXI_ADDR_WIDTH-1:0] o_reply_buf,
+    output wire                          o_complete_on_send,
+    output wire                          o_reply_poll,
+    output wire [                  31:0] o_reply_to,
+    output wire [                  31:0] o_reply_seq_off,
+    output wire [                   5:0] o_reply_stride_log2,
+
+    // Advance the SQ pointer
+    input wire                       adv,
+    input wire [C_CTX_IDX_WIDTH-1:0] adv_idx
+);
+
+    integer                          i;
+    reg     [    C_QP_IDX_WIDTH-1:0] qp_num   [0:C_NUM_CTX-1];
+    reg     [C_M_AXI_ADDR_WIDTH-1:0] sq_base  [0:C_NUM_CTX-1];
+    reg     [                  15:0] sq_depth [0:C_NUM_CTX-1];
+    reg     [                  15:0] sq_pi    [0:C_NUM_CTX-1];
+    reg     [C_M_AXI_ADDR_WIDTH-1:0] reply_buf[0:C_NUM_CTX-1];
+    reg                              comp_send[0:C_NUM_CTX-1];
+    reg                              rpl_poll [0:C_NUM_CTX-1];
+    reg     [                  31:0] rpl_to   [0:C_NUM_CTX-1];
+    reg     [                  31:0] rpl_seqo [0:C_NUM_CTX-1];
+    reg     [                   5:0] rpl_sll  [0:C_NUM_CTX-1];
+
+    assign o_qp_num            = qp_num[rd_ctx];
+    assign o_sq_base           = sq_base[rd_ctx];
+    assign o_sq_depth          = sq_depth[rd_ctx];
+    assign o_sq_pi             = sq_pi[rd_ctx];
+    assign o_reply_buf         = reply_buf[rd_ctx];
+    assign o_complete_on_send  = comp_send[rd_ctx];
+    assign o_reply_poll        = rpl_poll[rd_ctx];
+    assign o_reply_to          = rpl_to[rd_ctx];
+    assign o_reply_seq_off    = rpl_seqo[rd_ctx];
+    assign o_reply_stride_log2 = rpl_sll[rd_ctx];
+
+    // Config arrays
+    always @(posedge clk) begin
+        if (!cfg_rstn) begin
+            for (i = 0; i < C_NUM_CTX; i = i + 1) begin
+                qp_num[i]    <= {C_QP_IDX_WIDTH{1'b0}};
+                sq_base[i]   <= {C_M_AXI_ADDR_WIDTH{1'b0}};
+                sq_depth[i]  <= 16'd0;
+                reply_buf[i] <= {C_M_AXI_ADDR_WIDTH{1'b0}};
+                comp_send[i] <= 1'b0;
+                rpl_poll[i]  <= 1'b0;
+                rpl_to[i]    <= 32'd0;
+                rpl_seqo[i]  <= 32'd0;
+                rpl_sll[i]   <= 6'd0;
+            end
+        end else if (ctx_build) begin
+            qp_num[ctx_build_idx]    <= ctx_qp_num;
+            sq_base[ctx_build_idx]   <= ctx_sq_base;
+            sq_depth[ctx_build_idx]  <= ctx_sq_depth;
+            reply_buf[ctx_build_idx] <= ctx_reply_buf;
+            comp_send[ctx_build_idx] <= ctx_complete_on_send;
+            rpl_poll[ctx_build_idx]  <= ctx_reply_poll;
+            rpl_to[ctx_build_idx]    <= ctx_reply_to;
+            rpl_seqo[ctx_build_idx]  <= ctx_reply_seq_off;
+            rpl_sll[ctx_build_idx]   <= ctx_reply_stride_log2;
+        end
+    end
+
+    // Priority: rebind > adv
+    always @(posedge clk) begin
+        if (!core_rstn) begin
+            for (i = 0; i < C_NUM_CTX; i = i + 1) sq_pi[i] <= 16'd0;
+        end else begin
+            if (adv)
+                sq_pi[adv_idx] <= (sq_pi[adv_idx] >= sq_depth[adv_idx] - 16'd1) ?
+                                  16'd0 : sq_pi[adv_idx] + 16'd1;
+            if (ctx_build && ctx_rebind) sq_pi[ctx_build_idx] <= 16'd0;
+        end
+    end
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_read_dma.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_read_dma.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_read_dma.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_read_dma.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,115 @@
+//===----------------------------------------------------------------------===//
+//
+// hh_read_dma.v
+//
+// Minimal AXI4-compliant READ-only DMA: reads 64-byte per beat
+// Caller contract:
+//    * one transfer in flight at a time (assert `req` only when `busy`==0).
+//    * `addr` is 64-byte aligned (single beat never crosses a 4 KB boundary).
+//===----------------------------------------------------------------------===//
+`timescale 1ps / 1ps `default_nettype none
+
+module hh_read_dma #(
+    parameter integer C_M_AXI_ADDR_WIDTH = 64,
+    parameter integer C_M_AXI_DATA_WIDTH = 512,
+    parameter integer C_M_AXI_ID_WIDTH   = 1
+) (
+    input wire clk,
+    input wire rstn,
+
+    // COMMAND / STATUS
+    input  wire                          req,   // W1P to start
+    input  wire [C_M_AXI_ADDR_WIDTH-1:0] addr,  // 64B-aligned read address
+    output reg                           busy,
+    output reg                           done,  // 1-cycle pulse when `data` is valid
+    output reg  [C_M_AXI_DATA_WIDTH-1:0] data,  // captured beat (valid the cycle `done`=1)
+    output reg                           err,   // RRESP != OKAY
+
+    // AXI4 ADDRESS READ
+    output reg  [  C_M_AXI_ID_WIDTH-1:0] m_axi_arid,
+    output reg  [C_M_AXI_ADDR_WIDTH-1:0] m_axi_araddr,
+    output wire [                   7:0] m_axi_arlen,
+    output wire [                   2:0] m_axi_arsize,
+    output wire [                   1:0] m_axi_arburst,
+    output wire [                   3:0] m_axi_arcache,
+    output wire [                   2:0] m_axi_arprot,
+    output reg                           m_axi_arvalid,
+    input  wire                          m_axi_arready,
+    output wire                          m_axi_arlock,
+
+    // AXI4 DATA READ
+    input  wire [  C_M_AXI_ID_WIDTH-1:0] m_axi_rid,
+    input  wire [C_M_AXI_DATA_WIDTH-1:0] m_axi_rdata,
+    input  wire [                   1:0] m_axi_rresp,
+    input  wire                          m_axi_rlast,
+    input  wire                          m_axi_rvalid,
+    output reg                           m_axi_rready
+);
+    `include "hh_macros.vh"
+
+    // log2(DATA/8): 512b -> 64 bytes/beat -> arsize = 6
+    localparam [2:0] ARSIZE = clog2(C_M_AXI_DATA_WIDTH / 8);
+
+    assign m_axi_arsize  = ARSIZE;
+    assign m_axi_arburst = 2'b01;  // INCR
+    assign m_axi_arcache = 4'b0011;  // bufferable, modifiable
+    assign m_axi_arprot  = 3'b000;
+    assign m_axi_arlock  = 1'b0;
+    assign m_axi_arlen   = 8'd0;  // single 64-byte beat (arlen = beats-1)
+
+    localparam [1:0] S_IDLE = 2'd0, S_AR = 2'd1, S_R = 2'd2;
+    reg [1:0] state;
+
+    always @(posedge clk) begin
+        if (!rstn) begin
+            state         <= S_IDLE;
+            busy          <= 1'b0;
+            done          <= 1'b0;
+            err           <= 1'b0;
+            data          <= {C_M_AXI_DATA_WIDTH{1'b0}};
+            m_axi_arvalid <= 1'b0;
+            m_axi_arid    <= {C_M_AXI_ID_WIDTH{1'b0}}; // one outstanding
+            m_axi_araddr  <= {C_M_AXI_ADDR_WIDTH{1'b0}};
+            m_axi_rready  <= 1'b0;
+        end else begin
+            done <= 1'b0;
+            case (state)
+                S_IDLE: begin
+                    busy <= 1'b0;
+                    if (req) begin
+                        busy          <= 1'b1;
+                        m_axi_araddr  <= addr;
+                        m_axi_arvalid <= 1'b1;
+                        state         <= S_AR;
+                    end
+                end
+                S_AR: begin
+                    if (m_axi_arready && m_axi_arvalid) begin
+                        m_axi_arvalid <= 1'b0;
+                        m_axi_rready  <= 1'b1;
+                        state         <= S_R;
+                    end
+                end
+                S_R: begin
+                    if (m_axi_rvalid && m_axi_rready) begin
+                        data <= m_axi_rdata;
+                        if (m_axi_rresp != 2'b00) begin
+                            err <= 1'b1;
+                        end
+                        // single beat -> last
+                        if (m_axi_rlast) begin
+                            m_axi_rready <= 1'b0;
+                            done <= 1'b1;
+                            busy <= 1'b0;
+                            state <= S_IDLE;
+                        end
+                    end
+                end
+                default: state <= S_IDLE;
+            endcase
+        end
+    end
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_reply_ram.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_reply_ram.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_reply_ram.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_reply_ram.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,102 @@
+//===----------------------------------------------------------------------===//
+// hh_reply_ram.v - the reply buffer URAM
+//
+// This ring stores replies from the peer. ERNIC writes to it over AXI, while the
+// engine checks for the current round's reply and forwards the beat on m_axis (for transport demo)
+//
+//   +---------------------------------------------------------------------+
+//   | xpm_memory_tdpram - common clock                                    |
+//   |                                                                     |
+//   | Port A (rw): ERNIC -> SC_1         -> axi_bram_ctrl -> RAM (write)  |
+//   |              PS    -> SC_0 -> SC_1 -> axi_bram_ctrl -> RAM (read)   |
+//   | Port B (ro): RAM[slot] -> engine                                    |
+//   +---------------------------------------------------------------------+
+//
+//===----------------------------------------------------------------------===//
+
+`timescale 1ps / 1ps `default_nettype none (* DowngradeIPIdentifiedWarnings="yes" *)
+
+module hh_reply_ram #(
+    parameter integer C_SLOT_AW  = 8,    // entries = 2^C_SLOT_AW
+    parameter integer C_SLOT_DW  = 512,  // 64B per entry
+    parameter integer C_BRAM_DW  = 512,
+    parameter integer C_BRAM_AW  = 14,   // 8 + log2(64) = 14 for 256 x 64B
+    parameter integer C_BYTE_LSB = 6,    // log2(C_BRAM_DW/8)
+    parameter         C_PRIMITIVE = "ultra"
+) (
+    // Port A
+    input  wire                     bram_rst,
+    input  wire                     bram_clk,
+    input  wire                     bram_en,
+    input  wire [(C_BRAM_DW/8)-1:0] bram_we,
+    input  wire [    C_BRAM_AW-1:0] bram_addr,
+    input  wire [    C_BRAM_DW-1:0] bram_wrdata,
+    output wire [    C_BRAM_DW-1:0] bram_rddata,
+
+    // Port B
+    input  wire                 rd_clk,
+    input  wire                 rd_en,
+    input  wire [C_SLOT_AW-1:0] rd_slot,
+    output wire [C_SLOT_DW-1:0] rd_dout
+);
+
+    xpm_memory_tdpram #(
+        .MEMORY_SIZE       (C_SLOT_DW * (1 << C_SLOT_AW)),
+        .MEMORY_PRIMITIVE  (C_PRIMITIVE),
+        .CLOCKING_MODE     ("common_clock"),
+        .MEMORY_INIT_FILE  ("none"),
+        .MEMORY_INIT_PARAM (""),
+        .USE_MEM_INIT      (0),
+        .WAKEUP_TIME       ("disable_sleep"),
+        .MESSAGE_CONTROL   (0),
+        .ECC_MODE          ("no_ecc"),
+        .AUTO_SLEEP_TIME   (0),
+        // Port A
+        .WRITE_DATA_WIDTH_A(C_BRAM_DW),
+        .READ_DATA_WIDTH_A (C_BRAM_DW),
+        .BYTE_WRITE_WIDTH_A(8),
+        .ADDR_WIDTH_A      (C_SLOT_AW),
+        .READ_RESET_VALUE_A("0"),
+        .READ_LATENCY_A    (2),
+        .WRITE_MODE_A      ("no_change"),
+        // Port B
+        .WRITE_DATA_WIDTH_B(C_SLOT_DW),
+        .READ_DATA_WIDTH_B (C_SLOT_DW),
+        .BYTE_WRITE_WIDTH_B(C_SLOT_DW),
+        .ADDR_WIDTH_B      (C_SLOT_AW),
+        .READ_RESET_VALUE_B("0"),
+        .READ_LATENCY_B    (2),
+        .WRITE_MODE_B      ("no_change")
+    ) u_reply_ram (
+        .sleep         (1'b0),
+        // Port A
+        .clka          (bram_clk),
+        .rsta          (bram_rst),
+        .ena           (bram_en),
+        .regcea        (1'b1),
+        .wea           (bram_we),
+        .addra         (bram_addr[C_BRAM_AW-1:C_BYTE_LSB]),
+        .dina          (bram_wrdata),
+        .injectsbiterra(1'b0),
+        .injectdbiterra(1'b0),
+        .douta         (bram_rddata),
+        .sbiterra      (),
+        .dbiterra      (),
+        // Port B
+        .clkb          (rd_clk),
+        .rstb          (1'b0),
+        .enb           (rd_en),
+        .regceb        (1'b1),
+        .web           (1'b0),
+        .addrb         (rd_slot),
+        .dinb          ({C_SLOT_DW{1'b0}}),
+        .injectsbiterrb(1'b0),
+        .injectdbiterrb(1'b0),
+        .doutb         (rd_dout),
+        .sbiterrb      (),
+        .dbiterrb      ()
+    );
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_ring_state.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_ring_state.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_ring_state.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_ring_state.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,64 @@
+//===----------------------------------------------------------------------===//
+// hh_ring_state.v
+//
+//   Per-WQE round index, and the sequence number that round's reply must carry.
+//   The index wraps at ring_len, the sequence only at 2^32
+//===----------------------------------------------------------------------===//
+`timescale 1ps / 1ps `default_nettype none
+
+module hh_ring_state #(
+    parameter integer C_NUM_WQE       = 16,
+    parameter integer C_WQE_IDX_WIDTH = 4
+) (
+    input wire clk,
+    input wire core_rstn,
+
+    input wire                       buf_ring_reset,     // W1P
+    input wire [C_WQE_IDX_WIDTH-1:0] buf_ring_reset_idx,
+
+    input  wire [C_WQE_IDX_WIDTH-1:0] rd_idx,
+    output wire [               15:0] o_buf_ring_idx,
+    output wire [               31:0] o_reply_seq,
+
+    input wire                       adv,
+    input wire [C_WQE_IDX_WIDTH-1:0] adv_idx,
+    input wire [               15:0] adv_buf_ring_len,
+
+    input wire seq_adv  // same round as `adv`, but unconditional
+);
+
+    integer        i;
+    reg     [15:0] buf_ring_idx[0:C_NUM_WQE-1];
+    reg     [31:0] reply_seq   [0:C_NUM_WQE-1];
+
+    assign o_buf_ring_idx = buf_ring_idx[rd_idx];
+    assign o_reply_seq    = reply_seq[rd_idx];
+
+    // Priority: buf_ring_reset > adv
+    always @(posedge clk) begin
+        if (!core_rstn) begin
+            for (i = 0; i < C_NUM_WQE; i = i + 1) begin
+                buf_ring_idx[i] <= 16'd0;
+                reply_seq[i]    <= 32'd0;
+            end
+        end else begin
+            if (adv) begin
+                buf_ring_idx[adv_idx] <= (adv_buf_ring_len <= 16'd1 ||
+                                      buf_ring_idx[adv_idx] >= adv_buf_ring_len - 16'd1) ?
+                                     16'd0 : buf_ring_idx[adv_idx] + 16'd1;
+            end
+
+            if (seq_adv) begin
+                reply_seq[adv_idx] <= reply_seq[adv_idx] + 32'd1;
+            end
+
+            if (buf_ring_reset) begin
+                buf_ring_idx[buf_ring_reset_idx] <= 16'd0;
+                reply_seq[buf_ring_reset_idx]    <= 32'd0;
+            end
+        end
+    end
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_rtt_trace.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_rtt_trace.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_rtt_trace.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_rtt_trace.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,102 @@
+//===----------------------------------------------------------------------===//
+// hh_rtt_trace.v - the RTT trace RAM
+//
+// Each entry is a completed round rtt in clocks
+// And it is saturated if it exceeds 16 bits
+// It's supposed to be written by the engine, read by the PS after the run.
+//
+//   +------------------------------------------------------------------+
+//   | xpm_memory_tdpram - common clock                                 |
+//   |                                                                  |
+//   | Port A (wr): RAM[trace_addr] <= trace_din   (engine, core clock) |
+//   | Port B (rd): axi_bram_ctrl -> PS            (same clock net)     |
+//   +------------------------------------------------------------------+
+//
+//===----------------------------------------------------------------------===//
+
+`timescale 1ps / 1ps `default_nettype none (* DowngradeIPIdentifiedWarnings="yes" *)
+
+module hh_rtt_trace #(
+    parameter integer C_TRACE_AW = 20,  // entries = 2^C_TRACE_AW (1M x 16b = 2 MB)
+    parameter integer C_TRACE_DW = 16,  // rtt in cycles
+    parameter integer C_BRAM_DW  = 32
+) (
+    input wire clk,
+
+    // Port A: engine writes
+    input wire                  trace_we,
+    input wire [C_TRACE_AW-1:0] trace_addr,
+    input wire [C_TRACE_DW-1:0] trace_din,
+
+    // Port B: axi_bram_ctrl
+    input wire                     bram_rst,
+    input wire                     bram_clk,
+    input wire                     bram_en,
+    input wire [(C_BRAM_DW/8)-1:0] bram_we,
+
+    // byte address: what axi_bram_ctrl drives
+    input  wire [ C_TRACE_AW:0] bram_addr,
+    input  wire [C_BRAM_DW-1:0] bram_wrdata,
+    output wire [C_BRAM_DW-1:0] bram_rddata
+);
+
+    xpm_memory_tdpram #(
+        .MEMORY_SIZE       (C_TRACE_DW * (1 << C_TRACE_AW)),
+        .MEMORY_PRIMITIVE  ("ultra"),                          // lets vivado pick URAM for this size
+        .CLOCKING_MODE     ("common_clock"),
+        .MEMORY_INIT_FILE  ("none"),
+        .MEMORY_INIT_PARAM (""),
+        .USE_MEM_INIT      (0),
+        .WAKEUP_TIME       ("disable_sleep"),
+        .MESSAGE_CONTROL   (0),
+        .ECC_MODE          ("no_ecc"),
+        .AUTO_SLEEP_TIME   (0),
+        // Port A: engine write
+        .WRITE_DATA_WIDTH_A(C_TRACE_DW),
+        .READ_DATA_WIDTH_A (C_TRACE_DW),
+        .BYTE_WRITE_WIDTH_A(C_TRACE_DW),
+        .ADDR_WIDTH_A      (C_TRACE_AW),
+        .READ_RESET_VALUE_A("0"),
+        .READ_LATENCY_A    (1),
+        .WRITE_MODE_A      ("no_change"),
+        // Port B: PS read
+        .WRITE_DATA_WIDTH_B(C_BRAM_DW),
+        .READ_DATA_WIDTH_B (C_BRAM_DW),
+        .BYTE_WRITE_WIDTH_B(8),
+        .ADDR_WIDTH_B      (C_TRACE_AW - 1),
+        .READ_RESET_VALUE_B("0"),
+        .READ_LATENCY_B    (8),
+        .WRITE_MODE_B      ("no_change")
+    ) u_trace_ram (
+        .sleep         (1'b0),
+        // Port A
+        .clka          (clk),
+        .rsta          (1'b0),
+        .ena           (trace_we),
+        .regcea        (1'b0),
+        .wea           (trace_we),
+        .addra         (trace_addr),
+        .dina          (trace_din),
+        .injectsbiterra(1'b0),
+        .injectdbiterra(1'b0),
+        .douta         (),
+        .sbiterra      (),
+        .dbiterra      (),
+        // Port B
+        .clkb          (bram_clk),
+        .rstb          (bram_rst),
+        .enb           (bram_en),
+        .regceb        (1'b1),
+        .web           (bram_we),
+        .addrb         (bram_addr[C_TRACE_AW:2]),
+        .dinb          (bram_wrdata),
+        .injectsbiterrb(1'b0),
+        .injectdbiterrb(1'b0),
+        .doutb         (bram_rddata),
+        .sbiterrb      (),
+        .dbiterrb      ()
+    );
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_wqe_store.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_wqe_store.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_wqe_store.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_wqe_store.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,164 @@
+//===----------------------------------------------------------------------===//
+// hh_wqe_store.v
+//
+//   Instead of the control plane re-staging a 64-byte WQE for every round, the engine
+//   builds the descriptor once from control plane fields and keeps it in memory,
+//   addressed by a control plane-supplied index. Thereafter a round just names the index
+//   and lets the orchestrator fetch that descriptor, and push it to the SQ ring
+//
+//   Overview of the datapath:
+//
+//      AXI-Lite "build" (wr_clk)               Core "run" (rd_clk)
+//   +-----------------------------+      +-----------------------------+
+//   | WQE fields                  |      | hh_orchestrator             |
+//   |   wqe_opcode                |      |                             |
+//   |   wqe_xfer_bytes  wqe_rkey  |      | picks a stored descriptor   |
+//   |   wqe_va_{msb,lsb}          |      | by index (cfg_run_wqe_idx), |
+//   |   wqe_local_offset          |      | then pushes the fetched     |
+//   |   wqe_wrid                  |      | WQE to the SQ ring          |
+//   +--------------+--------------+      +---+-------------------+-----+
+//                  |                         |                   ^
+//                  | fields                  | rd_idx            | rd_data[511:0]
+//                  v                         |                   |
+//   +-----------------------------+          |                   |
+//   | Assmeble                    |          |                   |
+//   |   -> 64-byte descriptor     |          |                   |
+//   +--------------+--------------+          |                   |
+//                  |                         |                   |
+//                  | wqe_build (W1P)         |                   |
+//                  | @ wqe_build_idx         |                   |
+//                  v                         v                   |
+//   +--------------+-------------------------+-------------------+-----+
+//   | xpm_memory_tdpram - common clock (wr_clk == rd_clk)              |
+//   |                                                                  |
+//   | Port A (wr): RAM[wqe_build_idx] <= descriptor                    |
+//   | Port B (rd): rd_data            <= RAM[rd_idx]                   |
+//   +------------------------------------------------------------------+
+//
+//   NOTE: wr_clk and rd_clk must be the same clock net, currently, both should be come from
+//   pl0_ref_clk.
+//===----------------------------------------------------------------------===//
+`timescale 1ps / 1ps `default_nettype none (* DowngradeIPIdentifiedWarnings="yes" *)
+module hh_wqe_store #(
+    parameter integer C_M_AXI_DATA_WIDTH = 512,
+    parameter integer C_NUM_WQE          = 16,
+    parameter integer C_WQE_IDX_WIDTH    = 4,
+    parameter integer C_CTX_IDX_WIDTH    = 3     // qp_ref width (story 005: C_NUM_CTX ctxs)
+) (
+    // Build
+    input wire                       wr_clk,
+    input wire                       wr_rstn,
+    input wire                       wqe_build,         // W1P on a COMMIT write.
+    input wire [C_WQE_IDX_WIDTH-1:0] wqe_build_idx,
+    input wire [                1:0] wqe_opcode,        // 00 write, 01 read, 10 send
+    input wire [               31:0] wqe_xfer_bytes,    // RDMA transfer length in bytes
+    input wire [               31:0] wqe_rkey,
+    input wire [               31:0] wqe_va_lsb,
+    input wire [               31:0] wqe_va_msb,
+    input wire [               63:0] wqe_local_offset,  // local DDR buffer address
+    input wire [               15:0] wqe_wrid,
+
+    // Build: engine-side config packed into bytes 32-63 (stripped to 0 on the wire).
+    input wire                       wqe_buf_ring_en,
+    input wire [               15:0] wqe_buf_ring_len,
+    input wire [                5:0] wqe_stride_local_log2,
+    input wire [                5:0] wqe_stride_remote_log2,
+    input wire [C_CTX_IDX_WIDTH-1:0] wqe_qp_ref,
+
+    // Run
+    input  wire                          rd_clk,
+    input  wire                          rd_rstn,
+    input  wire [   C_WQE_IDX_WIDTH-1:0] rd_idx,
+    output wire [C_M_AXI_DATA_WIDTH-1:0] rd_data
+);
+
+    `include "hh_macros.vh"
+
+    // opcode byte
+    wire [                   7:0] opcode_byte = (wqe_opcode == 2'b1) ? 8'b100 : {6'b0, wqe_opcode};
+
+    // assemble the 64-byte WQE
+    // - bytes 0-31 = ERNIC descriptor
+    // - bytes 32-63 = engine-side config (ring cfg + qp_ref)
+    // - The config bytes are ERNIC-reserved and are stripped to 0 on the outgoing WQE by patch().
+    reg  [C_M_AXI_DATA_WIDTH-1:0] wqe_word;
+    always @(*) begin
+        // verilog-format-off
+        wqe_word = {C_M_AXI_DATA_WIDTH{1'b0}};
+        wqe_word[2*8-1 : 0*8]   = wqe_wrid;                  // bytes 0-1   WRID
+        wqe_word[12*8-1 : 4*8]  = wqe_local_offset;          // bytes 4-11  local offset
+        wqe_word[16*8-1 : 12*8] = wqe_xfer_bytes;            // bytes 12-15 data size (byte cnt)
+        wqe_word[17*8-1 : 16*8] = opcode_byte;               // byte  16    opcode
+        wqe_word[28*8-1 : 20*8] = {wqe_va_msb, wqe_va_lsb};  // bytes 20-27 remote VA
+        wqe_word[32*8-1 : 28*8] = wqe_rkey;                  // bytes 28-31 rkey
+        // verilog-format-on
+        // bytes 32-63: engine-side config (we just borrow the space as metadata):
+        // It means we also need to strip the metadata to 0 on the outgoing WQE.
+        wqe_word[`HH_CFG_RING_EN] = wqe_buf_ring_en;
+        wqe_word[`HH_CFG_RING_LEN_LSB+:16] = wqe_buf_ring_len;
+        wqe_word[`HH_CFG_SLL_LSB+:6] = wqe_stride_local_log2;
+        wqe_word[`HH_CFG_SRL_LSB+:6] = wqe_stride_remote_log2;
+        wqe_word[`HH_CFG_QPREF_LSB+:C_CTX_IDX_WIDTH] = wqe_qp_ref;
+    end
+
+    xpm_memory_tdpram #(
+        .MEMORY_SIZE       (C_M_AXI_DATA_WIDTH * C_NUM_WQE),
+        .MEMORY_PRIMITIVE  ("block"),
+        // wr_clk and rd_clk are the same physical net in this design (both traceto pl0_ref_clk)
+        .CLOCKING_MODE     ("common_clock"),
+        .MEMORY_INIT_FILE  ("none"),
+        .MEMORY_INIT_PARAM (""),
+        .USE_MEM_INIT      (1),
+        .WAKEUP_TIME       ("disable_sleep"),
+        .MESSAGE_CONTROL   (0),
+        .ECC_MODE          ("no_ecc"),
+        .AUTO_SLEEP_TIME   (0),
+        // Port A (write, lite)
+        .WRITE_DATA_WIDTH_A(C_M_AXI_DATA_WIDTH),
+        .READ_DATA_WIDTH_A (C_M_AXI_DATA_WIDTH),
+        .BYTE_WRITE_WIDTH_A(C_M_AXI_DATA_WIDTH),
+        .ADDR_WIDTH_A      (C_WQE_IDX_WIDTH),
+        .READ_RESET_VALUE_A("0"),
+        .READ_LATENCY_A    (1),
+        .WRITE_MODE_A      ("write_first"),
+        // Port B (read, core)
+        .WRITE_DATA_WIDTH_B(C_M_AXI_DATA_WIDTH),
+        .READ_DATA_WIDTH_B (C_M_AXI_DATA_WIDTH),
+        .BYTE_WRITE_WIDTH_B(C_M_AXI_DATA_WIDTH),
+        .ADDR_WIDTH_B      (C_WQE_IDX_WIDTH),
+        .READ_RESET_VALUE_B("0"),
+        .READ_LATENCY_B    (1),
+        .WRITE_MODE_B      ("write_first")
+    ) u_wqe_ram (
+        .sleep         (1'b0),
+        // Port A: write (lite domain)
+        .clka          (wr_clk),
+        .rsta          (~wr_rstn),
+        .ena           (1'b1),
+        .regcea        (1'b1),
+        .wea           (wqe_build),
+        .addra         (wqe_build_idx),
+        .dina          (wqe_word),
+        .injectsbiterra(1'b0),
+        .injectdbiterra(1'b0),
+        .douta         (),
+        .sbiterra      (),
+        .dbiterra      (),
+        // Port B: read (core domain)
+        .clkb          (rd_clk),
+        .rstb          (~rd_rstn),
+        .enb           (1'b1),
+        .regceb        (1'b1),
+        .web           (1'b0),
+        .addrb         (rd_idx),
+        .dinb          ({C_M_AXI_DATA_WIDTH{1'b0}}),
+        .injectsbiterrb(1'b0),
+        .injectdbiterrb(1'b0),
+        .doutb         (rd_data),
+        .sbiterrb      (),
+        .dbiterrb      ()
+    );
+
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_write_dma.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_write_dma.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_write_dma.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/hh_write_dma.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,142 @@
+//===----------------------------------------------------------------------===//
+//
+// hh_write_dma.v
+//
+// Minimal AXI4-compliant WRITE-only DMA: writes 64-byte per beat
+// Caller contract:
+//    * `beats` in [1..64] -> max 4 KB
+//    * one transfer in flight at a time (assert `req` only when `busy`==0).
+//    * `addr` is 64-byte aligned
+//===----------------------------------------------------------------------===//
+
+`timescale 1ps / 1ps `default_nettype none
+
+module hh_write_dma #(
+    parameter integer C_M_AXI_ADDR_WIDTH = 64,
+    parameter integer C_M_AXI_DATA_WIDTH = 512,
+    parameter integer C_M_AXI_ID_WIDTH   = 1
+) (
+    input wire clk,
+    input wire rstn,
+
+    // COMMAND / STATUS
+    input  wire                          req,    // W1P to start
+    input  wire [C_M_AXI_ADDR_WIDTH-1:0] addr,   // 64B-aligned write address
+    input  wire [                   8:0] beats,  // number of 64B beats
+    input  wire [C_M_AXI_DATA_WIDTH-1:0] fill,   // data
+    output reg                           busy,
