diff -r -N -U0 -w -B a/Makefile b/Makefile
--- a/Makefile	1969-12-31 19:00:00.000000000 -0500
+++ b/Makefile	2026-08-27 09:49:29.236622244 -0400
@@ -0,0 +1,83 @@
+SHELL := /bin/bash
+
+ROOT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+
+HW_DIR        := $(ROOT_DIR)/hw
+SW_DIR        := $(ROOT_DIR)/sw
+PROJ_DIR      := $(ROOT_DIR)/sw/peta_proj/ernic/vpk120_mrmac/amd-ernic-vpk120_mrmac-2024-bsp
+
+BUILD_TCL     ?= $(HW_DIR)/build.tcl
+SW_BUILD_SH   ?= $(SW_DIR)/sw_build.sh
+
+JOBS ?= 1
+CLEAN ?= 0
+
+# Set clean flag
+VIVADO_CLEAN_FLAG := $(if $(filter 1,$(CLEAN)),-clean,)
+
+# Executables & File Paths
+VIVADO        ?= vivado
+PROJECT_NAME  ?= vpk120m_ernic_ref_design
+TOP_NAME      ?= ernic_mrmac_0_imp_top
+XSA_PATH      ?= $(HW_DIR)/$(TOP_NAME).xsa
+BSP_PATH            ?= $(BSP_PATH)
+VPK_INIT_CONFIG_DIR ?= $(VPK_INIT_CONFIG_DIR)
+# Convert CLEAN=1 variable into the '-clean' flag parsed by build.tcl
+VIVADO_CLEAN_FLAG := $(if $(filter 1,$(CLEAN)),-clean,)
+
+.PHONY: all vivado_build peta_build jtag-boot boot-fpga full clean help
+
+## Run Vivado HW Build (build.tcl)
+vivado_build: $(BUILD_TCL)
+	@echo "Running Vivado build: $(BUILD_TCL) (JOBS=$(JOBS), CLEAN=$(CLEAN))"
+	cd $(HW_DIR) && $(VIVADO) -mode batch -source $(BUILD_TCL) -tclargs -jobs $(JOBS) -project $(PROJECT_NAME) -top $(TOP_NAME) $(VIVADO_CLEAN_FLAG)
+
+## Run PetaLinux SW Build (sw_build.sh)
+peta_build: $(SW_BUILD_SH)
+	@echo "==> Running PetaLinux build via $(SW_BUILD_SH)..."
+	@export XSA_PATH="$(XSA_PATH)"; \
+	 export BSP_PATH="$(BSP_PATH)"; \
+	 export HW_DIR="$(HW_DIR)"; \
+	 export VPK_INIT_CONFIG_DIR="$(VPK_INIT_CONFIG_DIR)"; \
+	 export SW_DIR="$(SW_DIR)"; \
+	 cd $(SW_DIR) && bash $(SW_BUILD_SH)
+
+## Clean build logs and temporary files
+clean:
+	@echo "Cleaning temporary Vivado log files and outputs"
+	rm -rf .Xil *.log *.jou *.str *.xsa
+	@echo "Clean completed."
+
+jtag-boot:
+	@echo "Creating jtag-boot.tcl in petalinux project"
+	cd $(PROJ_DIR) && petalinux-boot jtag --kernel images/linux/Image --rootfs images/linux/rootfs.cpio.gz.u-boot --tcl jtag-boot.tcl  && sed -i 's/\*PMC\*/PMC/g' jtag-boot.tcl
+
+boot-fpga:
+	@echo "Program the VPK120 board"
+	cd $(PROJ_DIR) && xsdb jtag-boot.tcl
+
+## Run both Hardware and Software builds sequentially
+full: vivado_build peta_build jtag-boot boot-fpga
+
+## Display usage and help
+help:
+	@printf "Usage:\n"
+	@printf "  make [target] [VARIABLES]\n\n"
+	@printf "Targets:\n"
+	@printf "  make vivado_build  Run Vivado hardware compilation using $(BUILD_TCL)\n"
+	@printf "  make jtag-boot     Make jtag-boot tcl\n"
+	@printf "  make boot-fpga     Program the VPK120 board\n"
+	@printf "  make peta_build    Run PetaLinux image compilation using $(SW_BUILD_SH)\n"
+	@printf "  make full          Run hardware build followed by software build (default)\n"
+	@printf "  make clean         Clean temporary Vivado logs and artifacts\n"
+	@printf "  make help          Show this help message\n\n"
+	@printf "Configurable Variables:\n"
+	@printf "  JOBS=<N>           Number of parallel synthesis/implementation jobs (default: 1)\n"
+	@printf "  CLEAN=1            Reset and re-generate design runs before building (default: 0)\n"
+	@printf "  VIVADO=<path>      Path to Vivado executable (default: vivado)\n"
+	@printf "  BSP_PATH=<path>    Path to PetaLinux BSP file\n"
+	@printf "  XSA_PATH=<path>    Path to exported hardware platform file (.xsa)\n\n"
+	@printf "Examples:\n"
+	@printf "  make vivado_build JOBS=8 CLEAN=1\n"
+	@printf "  make full JOBS=16 BSP_PATH=/path/to/custom.bsp\n"
+
diff -r -N -U0 -w -B a/README.md b/README.md
--- a/README.md	1969-12-31 19:00:00.000000000 -0500
+++ b/README.md	2026-08-27 09:49:29.237622244 -0400
@@ -0,0 +1,54 @@
+# ERNIC VPK120 MRMAC reference design
+
+The AMD **ERNIC VPK120 MRMAC reference design**, v1.3 (release `ERNIC-2024_2_VPK120_RC6`),
+tracked here. Source: https://drive.google.com/file/d/1eyaCi_nAHHVfGXy2c6sg-F0bvZaT16BL/view?usp=sharing
+
+- **Toolchain:** AMD Vivado **2024.2** + PetaLinux **2024.2**
+- **Board / device:** VPK120, Versal Premium `xcvp1202`
+- **Source:** extracted verbatim from `reference design VPK120_mrmac_rev_1.3.zip`
+
+## Layout
+- `hw/`   — hardware source; in Vivado, `source vpk120m_ernic_ref_design.tcl` recreates the whole project
+- `sw/`   — PetaLinux software source (recipes, drivers, test apps)
+- `docs/` — AMD reference design guide + release notes
+
+The large vendor binaries (the BSP, the Vivado/PetaLinux installers, and the prebuilt
+board images) are **not** in git. On **nova** they live under `/opt/ernic`.
+
+
+## Building the project
+A Makefile provides synthesis, compilation and board programming
+
+### Environment Setup
+
+Before running the build targets, you must configure your shell environment by sourcing the Vivado and PetaLinux toolchains:
+
+```bash
+source /path/to/vivado/2024.2/settings64.sh
+source /path/to/petalinux/settings.sh
+```
+
+Next, export the path to your downloaded XSCT BSP. You can also optionally define your VPK_INIT_CONFIG_DIR at this stage, baseline scripts found under (sw/vpk_init):
+
+```bash
+export BSP_PATH="/path/to/xilinx-vpk120-xsct-v2024.2-final.bsp"
+
+# Optional:
+# export VPK_INIT_CONFIG_DIR="/path/to/your/config/dir"
+```
+
+### Available Make Targets
+* make vivado_build: Runs the Vivado hardware compiler through the hw/build.tcl script
+* make peta_build: Runs Petalinux image compilation through the sw/sw_build.tcl script
+* make jtag-boot: Create jtag-boot.tcl within the Petalinux project directory for jtag flashing
+* make boot-fpga: Programs the VPK120 board through the generated jtag-boot script
+* make full: runs hardware build, software build, jtag-boot generation and FPGA programming in sequence
+* make help: Displays help message outlining usage
+
+### Configuration Variables
+* JOBS=<N>: Sets the number of parallel synthesis/implementation jobs (default is 1).
+* CLEAN=1: Passes the -clean flag to reset and re-generate design runs before building (defaults to 0).
+* VIVADO=<path>: Specifies the path to the Vivado executable (defaults to vivado).
+* BSP_PATH=<path>: Specifies the path to the PetaLinux BSP file.
+* XSA_PATH=<path>: Specifies the path to the exported hardware platform .xsa file (defaults to hw/ernic_mrmac_0_imp_top.xsa).
+* VPK_INIT_CONFIG_DIR=<path>: Specifies the directory path for the VPK initialization configuration.
diff -r -N -U0 -w -B a/hw/build.tcl b/hw/build.tcl
--- a/hw/build.tcl	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/build.tcl	2026-08-27 09:49:29.242622245 -0400
@@ -0,0 +1,129 @@
+# cd /path/to/project
+# Some Examples:
+# $ vivado -mode batch -source build.tcl 
+# $ vivado -mode batch -source build.tcl -tclargs -jobs 1 -clean
+
+#################################################
+# Arguments
+#################################################
+set project_name "vpk120m_ernic_ref_design"
+set top_name     "ernic_mrmac_0_imp_top"
+set bd_name      "project_1.bd"
+set jobs         1
+set clean        0
+
+# Parse optional arguments passed via -tclargs
+if { $::argc > 0 } {
+    for {set i 0} {$i < $::argc} {incr i} {
+        set option [string trim [lindex $::argv $i]]
+        switch -exact -- $option {
+            "-jobs" {
+                incr i
+                set jobs [lindex $::argv $i]
+            }
+            "-clean" {
+                set clean 1
+            }
+            "-project" {
+                incr i
+                set project_name [lindex $::argv $i]
+            }
+            "-top" {
+                incr i
+                set top_name [lindex $::argv $i]
+            }
+            default {
+                puts "WARNING: Unknown option $option"
+            }
+        }
+    }
+}
+
+puts "INFO: Running with jobs=$jobs, clean=$clean"
+
+#################################################
+# Project Setup
+#################################################
+set project_xpr  "$project_name/$project_name.xpr"
+set project_tcl  "$project_name.tcl"
+set xsa_output   "${top_name}.xsa"
+
+# Open the project iff it exists, otherwise create it from tcl
+if {[file exists $project_xpr]} {
+    puts "INFO: Existing project found at $project_xpr"
+    open_project $project_xpr
+} else {
+    puts "INFO: Project not found, creating it from $project_tcl"
+    if {![file exists $project_tcl]} {
+        error "Cannot find $project_tcl"
+    }
+
+    set ::argv {}
+    set ::argc 0
+
+    source $project_tcl
+}
+
+# Make sure project.tcl left a project room
+if {[llength [get_projects -quiet]] == 0} {
+    error "project.tcl completed, but no vivado project is open"
+}
+
+#################################################
+# Helpers
+#################################################
+proc check_run {run_name} {
+    set status [get_property STATUS [get_runs $run_name]]
+    puts "INFO: $run_name status: $status"
+
+    if {![string match "*Complete!" $status]} {
+        error "$run_name failed. Status: $status"
+    }
+}
+
+#################################################
+# Build
+#################################################
+
+# Clean build based on optional arg
+if {$clean == 1} {
+    puts "INFO: Cleaning previous runs..."
+    reset_target all [get_files $bd_name]
+    generate_target all [get_files $bd_name]
+    reset_run synth_1
+}
+
+# Only launch if the run isn't already complete OR if we just cleaned it
+set current_status [get_property STATUS [get_runs synth_1]]
+
+if {[string match "*Complete!" $current_status]} {
+    puts "INFO: Synthesis is already complete and up-to-date. Skipping..."
+} else {
+    puts "INFO: Starting Synthesis..."
+    launch_runs synth_1 -jobs $jobs
+    wait_on_run synth_1
+    check_run synth_1
+}
+
+puts "INFO: Starting Implementation and image generation"
+launch_runs impl_1 -to_step write_device_image -jobs $jobs
+
+wait_on_run impl_1
+check_run impl_1
+
+set output_dir [get_property DIRECTORY [get_runs impl_1]]
+puts "INFO: Build completed successfully"
+puts "INFO: Output directory: $output_dir"
+
+# Ensure the implemented design is open before exporting (required by some Vivado versions)
+open_run impl_1 -name impl_1
+
+# Export .xsa
+write_hw_platform -fixed -include_bit -force -file "$xsa_output"
+puts "INFO: Generated hardware platform (XSA): [file normalize ${top_name}.xsa]"
+
+puts "INFO: Generated images:"
+foreach image [concat \
+    [glob -nocomplain -directory $output_dir *.pdi]] {
+        puts " $image"
+    }
diff -r -N -U0 -w -B a/hw/hdl/transport_demo.v b/hw/hdl/transport_demo.v
--- a/hw/hdl/transport_demo.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/hdl/transport_demo.v	2026-08-27 09:49:29.244306326 -0400
@@ -0,0 +1,285 @@
+`timescale 1ns / 10ps
+`default_nettype none
+
+module transport_demo #(
+    // Base addresses
+    parameter BRAM_START_ADDR     = 32'h8000_0000 // Start address for syndromes
+)(
+    input wire clk,
+    input wire resetn,
+
+    // FREQ_num is the base counter which is used to set the data transmission rate
+    input wire [63:0] freq_num,
+
+    input wire start_demo,
+    input wire reset_demo,
+
+    input wire [31:0]  syn_sum,
+
+    // AXI4 Master Interface0 (BRAM Read-Only for TX)
+    output reg  [31:0]  m_axi_araddr_0,
+    output wire [7:0]   m_axi_arlen_0,
+    output wire [2:0]   m_axi_arsize_0,
+    output reg          m_axi_arvalid_0,
+    input  wire         m_axi_arready_0,
+
+    input  wire [511:0] m_axi_rdata_0,
+    input  wire         m_axi_rlast_0,
+    input  wire         m_axi_rvalid_0,
+    output reg          m_axi_rready_0,
+
+    // AXI4 Master Interface1 (BRAM Read-Only for RX)
+    output reg  [31:0]  m_axi_araddr_1,
+    output wire [7:0]   m_axi_arlen_1,
+    output wire [2:0]   m_axi_arsize_1,
+    output reg          m_axi_arvalid_1,
+    input  wire         m_axi_arready_1,
+
+    input  wire [511:0] m_axi_rdata_1,
+    input  wire         m_axi_rlast_1,
+    input  wire         m_axi_rvalid_1,
+    output reg          m_axi_rready_1,
+
+    // AXI4-Stream Master
+    output reg  [511:0] m_axis_tdata,
+    output reg          m_axis_tvalid,
+    input  wire         m_axis_tready,
+    output wire         m_axis_tlast,    // Tied high for single-beat packets
+
+    // AXI4-Stream Slave
+    input  wire [511:0] s_axis_tdata,
+    input  wire         s_axis_tvalid,
+    output reg          s_axis_tready,
+    input  wire         s_axis_tlast,    // Ignored in this single-beat logic
+
+    output reg cmp_error,
+    output reg cmp_valid,
+    output wire demo_done,
+
+    //depth of syndromes words in BRAM
+    input wire [31:0] syn_depth,
+    input wire [31:0] reply_seq_off,
+
+    // 200 MHz: 1 ms = 200_000 cycles. mask 0x0FFF_FFFF -> 1 ms .. 1.34 s
+    input wire [31:0] freq_span_mask,
+    input wire [31:0] lfsr_seed
+);
+
+   // Constant AXI values
+    assign m_axi_arlen_0  = 8'd0;       // 1 beat per read
+    assign m_axi_arsize_0 = 3'b110;     // 64 bytes (512 bits)
+    assign m_axi_arlen_1  = 8'd0;       // 1 beat per read
+    assign m_axi_arsize_1 = 3'b110;     // 64 bytes (512 bits)
+    assign m_axis_tlast = 1'b1;       // Single beat stream packet
+
+    // Internal Registers
+    reg [31:0]  bram_addr_main;
+    reg [31:0]  bram_addr_arb;
+    reg [511:0] fetched_data_512b;
+    reg [511:0] rx_fetched_data_512b;
+    reg [511:0] axis_rx_data_512b;
+    reg [63:0] freq_cnt;
+    reg tx_update;
+    reg rx_update;
+
+    reg [31:0] syn_count;
+    reg [31:0] compl_count;
+
+    assign demo_done = (compl_count == syn_sum);
+
+    // FSM States
+    localparam [2:0]
+        S_IDLE        = 3'd0,
+        S_BRAM_AR1    = 3'd1,
+        S_BRAM_R1     = 3'd2,
+        S_AXIS_TX     = 3'd3,
+        S_AXIS_RX     = 3'd4,
+        S_BRAM_AR2    = 3'd5,
+        S_BRAM_R2     = 3'd6,
+        S_INC         = 3'd7;
+
+    reg [2:0] state_tx;
+    reg [2:0] state_rx;
+
+    wire tx_en = tx_update == rx_update;
+
+    // Fib LFSR: 32-bit maximal-length (taps 32,22,2,1), advanced once per send
+    // https://en.wikipedia.org/wiki/Linear-feedback_shift_register
+    reg  [31:0] lfsr;
+    wire [31:0] lfsr_init = (lfsr_seed != 32'd0) ? lfsr_seed : 32'hACE1_2345;
+    wire        lfsr_fb   = lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0];
+    wire [63:0] next_interval = freq_num + {32'd0, (lfsr & freq_span_mask)};
+
+    // shift per cycle
+    always @(posedge clk) begin
+        if (!resetn || reset_demo) lfsr <= lfsr_init;
+        else                       lfsr <= {lfsr[30:0], lfsr_fb};
+    end
+
+    wire [3:0]   seq_dw   = reply_seq_off[5:2];
+    wire [511:0] payload_mask = {{384{1'b0}}, {128{1'b1}}};
+    wire [511:0] seq_mask = payload_mask & ~({{480{1'b0}}, 32'hFFFF_FFFF} << (seq_dw * 32));
+
+    always @(posedge clk) begin
+        if (!resetn) begin
+            state_tx           <= S_IDLE;
+            bram_addr_main  <= BRAM_START_ADDR;
+
+            m_axi_arvalid_0   <= 1'b0;
+            m_axi_rready_0    <= 1'b0;
+
+            m_axis_tvalid   <= 1'b0;
+            m_axis_tdata    <= 512'd0;
+
+            freq_cnt        <= 64'b0;
+            tx_update       <= 1'b0;
+            syn_count       <= 32'd0;
+        end else begin
+            if (reset_demo) begin
+                syn_count <= 32'd0;
+                tx_update <= 1'b0;
+                freq_cnt <= 64'b0;
+                bram_addr_main  <= BRAM_START_ADDR;
+            end else begin
+                case (state_tx)
+                    S_IDLE: begin
+                        if (start_demo && (syn_count < syn_sum)) begin
+                            if (freq_cnt == 64'b0) begin
+                                //prevent TX overruning RX in roundtrip mode
+                                if (tx_en) begin
+                                    state_tx <= S_BRAM_AR1;
+                                end
+                            end else begin
+                                freq_cnt <= freq_cnt - 1;
+                            end
+                        end
+                    end
+
+                    S_BRAM_AR1: begin
+                        m_axi_araddr_0  <= bram_addr_main;
+                        m_axi_arvalid_0 <= 1'b1;
+                        if (m_axi_arvalid_0 && m_axi_arready_0) begin
+                            m_axi_arvalid_0 <= 1'b0;
+                            m_axi_rready_0  <= 1'b1;
+                            state_tx         <= S_BRAM_R1;
+                        end
+                    end
+
+                    S_BRAM_R1: begin
+                        if (m_axi_rready_0 && m_axi_rvalid_0) begin
+                            m_axi_rready_0      <= 1'b0;
+                            fetched_data_512b <= m_axi_rdata_0;
+                            state_tx             <= S_AXIS_TX;
+                        end
+                    end
+
+                    S_AXIS_TX: begin
+                        m_axis_tdata  <= fetched_data_512b;
+                        m_axis_tvalid <= 1'b1;
+                        if (m_axis_tvalid && m_axis_tready) begin
+                            m_axis_tvalid <= 1'b0;
+
+                            state_tx <= S_INC;
+                        end
+                    end
+
+                    S_INC: begin
+                        if ((bram_addr_main - BRAM_START_ADDR) + 32'd64 >= syn_depth) begin
+                            bram_addr_main <= BRAM_START_ADDR;
+                        end else begin
+                            bram_addr_main <= bram_addr_main + 32'd64;
+                        end
+
+                        freq_cnt  <= next_interval;
+                        tx_update <= ~tx_update;
+
+                        state_tx <= S_IDLE;
+                        syn_count <= syn_count + 1;
+                    end
+
+                    default: state_tx <= S_IDLE;
+                endcase
+            end
+        end
+    end
+
+    always @(posedge clk) begin
+        if (!resetn) begin
+            state_rx           <= S_AXIS_RX;
+            bram_addr_arb   <= BRAM_START_ADDR + syn_depth;
+
+            m_axi_arvalid_1   <= 1'b0;
+            m_axi_rready_1    <= 1'b0;
+
+            s_axis_tready   <= 1'b0;
+            rx_update <= 1'b0;
+            cmp_valid <= 1'b0;
+            compl_count       <= 32'd0;
+        end else begin
+            if (reset_demo) begin
+                cmp_valid <= 1'b0;
+                rx_update <= 1'b0;
+                bram_addr_arb   <= BRAM_START_ADDR + syn_depth;
+                compl_count       <= 32'd0;
+            end else begin
+                cmp_valid <= 1'b0;
+
+                case (state_rx)
+
+                    S_AXIS_RX: begin
+                        s_axis_tready <= 1'b1;
+                        if (s_axis_tready && s_axis_tvalid) begin
+                            s_axis_tready     <= 1'b0;
+                            axis_rx_data_512b <= s_axis_tdata;
+                            state_rx             <= S_BRAM_AR2;
+                        end
+                    end
+
+                    S_BRAM_AR2: begin
+                        m_axi_araddr_1  <= bram_addr_arb;
+                        m_axi_arvalid_1 <= 1'b1;
+                        if (m_axi_arvalid_1 && m_axi_arready_1) begin
+                            m_axi_arvalid_1 <= 1'b0;
+                            m_axi_rready_1  <= 1'b1;
+                            state_rx         <= S_BRAM_R2;
+                        end
+                    end
+
+                    S_BRAM_R2: begin
+                        if (m_axi_rready_1 && m_axi_rvalid_1) begin
+                            m_axi_rready_1      <= 1'b0;
+                            rx_fetched_data_512b <= m_axi_rdata_1;
+                            state_rx             <= S_INC;
+                        end
+                    end
+
+                    S_INC: begin
+                        if ((bram_addr_arb - (BRAM_START_ADDR + syn_depth)) + 32'd64 >= syn_depth) begin
+                            bram_addr_arb <= BRAM_START_ADDR + syn_depth;
+                        end else begin
+                            bram_addr_arb <= bram_addr_arb + 32'd64;
+                        end
+
+                        rx_update <= ~rx_update;
+                        state_rx <= S_AXIS_RX;
+
+                        // mask off the seq_num DWord
+                        if ((axis_rx_data_512b & seq_mask) ==
+                            (rx_fetched_data_512b & seq_mask)) begin
+                            cmp_valid <= 1'b1;
+                            cmp_error <= 1'b0;
+                        end else begin
+                            cmp_valid <= 1'b1;
+                            cmp_error <= 1'b1;
+                        end
+                        compl_count       <= compl_count + 1;
+                    end
+
+                    default: state_rx <= S_AXIS_RX;
+                endcase
+            end
+        end
+    end
+endmodule
+
+`default_nettype wire
