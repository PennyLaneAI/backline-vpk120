+//===----------------------------------------------------------------------===//
+// tb_hh_ctx_ring.v
+//
+// build/run: iverilog -g2012 -o tb_ctx.vvp tb_hh_ctx_ring.v hh_qp_ctx.v hh_ring_state.v && vvp tb_ctx.vvp
+//        or: xvlog hh_qp_ctx.v hh_ring_state.v tb_hh_ctx_ring.v && xelab tb_hh_ctx_ring -R
+//
+//===----------------------------------------------------------------------===//
+`timescale 1ns / 1ps `default_nettype none
+
+module tb_hh_ctx_ring;
+    localparam integer AW = 64, QPW = 8;
+    localparam integer NCTX = 4, CTXW = 2;
+    localparam integer NWQE = 4, WQEW = 2;
+
+    reg clk = 1'b0;
+    always #2.5 clk = ~clk;  // 200 MHz
+
+    integer errors = 0;
+    task chk(input [63:0] got, input [63:0] exp, input [8*40-1:0] name);
+        begin
+            if (got !== exp) begin
+                $display("  FAIL  %0s: got=%0d exp=%0d", name, got, exp);
+                errors = errors + 1;
+            end else $display("  ok    %0s = %0d", name, got);
+        end
+    endtask
+
+    // QP Context Table
+    reg qc_cfg_rstn, qc_core_rstn;
+    reg             qc_build;
+    reg  [CTXW-1:0] qc_build_idx;
+    reg             qc_rebind;
+    reg  [ QPW-1:0] qc_qp_num;
+    reg  [  AW-1:0] qc_sq_base;
+    reg  [    15:0] qc_sq_depth;
+    reg  [CTXW-1:0] qc_rd_ctx;
+    wire [ QPW-1:0] qc_o_qp_num;
+    wire [  AW-1:0] qc_o_sq_base;
+    wire [15:0] qc_o_sq_depth, qc_o_sq_pi;
+    reg            qc_adv;
+    reg [CTXW-1:0] qc_adv_idx;
+
+    hh_qp_ctx #(
+        .C_M_AXI_ADDR_WIDTH(AW),
+        .C_QP_IDX_WIDTH    (QPW),
+        .C_NUM_CTX         (NCTX),
+        .C_CTX_IDX_WIDTH   (CTXW)
+    ) dut_qpc (
+        .clk              (clk),
+        .cfg_rstn         (qc_cfg_rstn),
+        .core_rstn        (qc_core_rstn),
+        .ctx_build        (qc_build),
+        .ctx_build_idx    (qc_build_idx),
+        .ctx_rebind       (qc_rebind),
+        .ctx_qp_num       (qc_qp_num),
+        .ctx_sq_base      (qc_sq_base),
+        .ctx_sq_depth     (qc_sq_depth),
+        .rd_ctx           (qc_rd_ctx),
+        .o_qp_num         (qc_o_qp_num),
+        .o_sq_base        (qc_o_sq_base),
+        .o_sq_depth       (qc_o_sq_depth),
+        .o_sq_pi          (qc_o_sq_pi),
+        .adv              (qc_adv),
+        .adv_idx          (qc_adv_idx)
+    );
+
+    // Ring State
+    reg             rs_core_rstn;
+    reg             rs_reset;
+    reg  [WQEW-1:0] rs_reset_idx;
+    reg  [WQEW-1:0] rs_rd_idx;
+    wire [    15:0] rs_o_ring_idx;
+    reg             rs_adv;
+    reg  [WQEW-1:0] rs_adv_idx;
+    reg  [    15:0] rs_adv_len;
+
+    hh_ring_state #(
+        .C_NUM_WQE      (NWQE),
+        .C_WQE_IDX_WIDTH(WQEW)
+    ) dut_ring (
+        .clk               (clk),
+        .core_rstn         (rs_core_rstn),
+        .buf_ring_reset    (rs_reset),
+        .buf_ring_reset_idx(rs_reset_idx),
+        .rd_idx            (rs_rd_idx),
+        .o_buf_ring_idx    (rs_o_ring_idx),
+        .adv               (rs_adv),
+        .adv_idx           (rs_adv_idx),
+        .adv_buf_ring_len  (rs_adv_len)
+    );
+
+    task qc_do_build(input [CTXW-1:0] i, input [QPW-1:0] q, input [AW-1:0] b,
+                     input [15:0] d, input rp);
+        begin
+            @(posedge clk);
+            qc_build     <= 1;
+            qc_build_idx <= i;
+            qc_rebind <= rp;
+            qc_qp_num    <= q;
+            qc_sq_base   <= b;
+            qc_sq_depth  <= d;
+            @(posedge clk);
+            qc_build     <= 0;
+            qc_rebind <= 0;
+            #1;
+        end
+    endtask
+    task qc_do_adv(input [CTXW-1:0] i);
+        begin
+            @(posedge clk);
+            qc_adv     <= 1;
+            qc_adv_idx <= i;
+            @(posedge clk);
+            qc_adv <= 0;
+            #1;
+        end
+    endtask
+    task rs_do_adv(input [WQEW-1:0] i, input [15:0] len);
+        begin
+            @(posedge clk);
+            rs_adv     <= 1;
+            rs_adv_idx <= i;
+            rs_adv_len <= len;
+            @(posedge clk);
+            rs_adv <= 0;
+            #1;
+        end
+    endtask
+    task rs_do_reset(input [WQEW-1:0] i);
+        begin
+            @(posedge clk);
+            rs_reset     <= 1;
+            rs_reset_idx <= i;
+            @(posedge clk);
+            rs_reset <= 0;
+            #1;
+        end
+    endtask
+
+    initial begin
+        qc_cfg_rstn      = 0;
+        qc_core_rstn     = 0;
+        qc_build         = 0;
+        qc_build_idx     = 0;
+        qc_rebind        = 0;
+        qc_qp_num        = 0;
+        qc_sq_base       = 0;
+        qc_sq_depth      = 0;
+        qc_rd_ctx        = 0;
+        qc_adv           = 0;
+        qc_adv_idx       = 0;
+        rs_core_rstn     = 0;
+        rs_reset         = 0;
+        rs_reset_idx     = 0;
+        rs_rd_idx        = 0;
+        rs_adv           = 0;
+        rs_adv_idx       = 0;
+        rs_adv_len       = 0;
+        repeat (3) @(posedge clk);
+        qc_cfg_rstn  = 1;
+        qc_core_rstn = 1;
+        rs_core_rstn = 1;
+        #1;
+
+        // Ring State
+        $display("[ring_state] advance + wrap (ring_len=4 on idx0)");
+        rs_rd_idx = 0;
+        #1;
+        chk(rs_o_ring_idx, 0, "ring0 init");
+        rs_do_adv(0, 4);
+        chk(rs_o_ring_idx, 1, "ring0 a1");
+        rs_do_adv(0, 4);
+        chk(rs_o_ring_idx, 2, "ring0 a2");
+        rs_do_adv(0, 4);
+        chk(rs_o_ring_idx, 3, "ring0 a3");
+        rs_do_adv(0, 4);
+        chk(rs_o_ring_idx, 0, "ring0 wrap");
+
+        $display("[ring_state] persistence across index switch");
+        rs_do_adv(0, 4);
+        rs_do_adv(0, 4);  // idx0 -> 2
+        rs_rd_idx = 1;
+        #1;
+        chk(rs_o_ring_idx, 0, "ring1 init");
+        rs_do_adv(1, 4);  // idx1 -> 1
+        rs_rd_idx = 0;
+        #1;
+        chk(rs_o_ring_idx, 2, "ring0 resumes @2");
+        rs_rd_idx = 1;
+        #1;
+        chk(rs_o_ring_idx, 1, "ring1 resumes @1");
+
+        $display("[ring_state] test reset");
+        rs_do_reset(0);
+        rs_rd_idx = 0;
+        #1;
+        chk(rs_o_ring_idx, 0, "ring0 after reset");
+        rs_rd_idx = 1;
+        #1;
+        chk(rs_o_ring_idx, 1, "ring1 untouched by reset");
+
+        // QP Context Table
+        $display("[qp_ctx] commit ctx0 {qp=5, base=0x1000, depth=4} rebind=1");
+        qc_do_build(0, 8'd5, 64'h1000, 16'd4, 1'b1);
+        qc_rd_ctx = 0;
+        #1;
+        chk(qc_o_qp_num, 5, "ctx0 qp_num");
+        chk(qc_o_sq_base, 64'h1000, "ctx0 sq_base");
+        chk(qc_o_sq_depth, 4, "ctx0 depth");
+        chk(qc_o_sq_pi, 0, "ctx0 sq_pi init");
+
+        $display("[qp_ctx] sq_pi advance + wrap (depth=4)");
+        qc_do_adv(0);
+        chk(qc_o_sq_pi, 1, "ctx0 pi a1");
+        qc_do_adv(0);
+        chk(qc_o_sq_pi, 2, "ctx0 pi a2");
+        qc_do_adv(0);
+        chk(qc_o_sq_pi, 3, "ctx0 pi a3");
+        qc_do_adv(0);
+        chk(qc_o_sq_pi, 0, "ctx0 pi wrap");
+
+        $display("[qp_ctx] config-only re-commit (same id, rebind=0) -> sq_pi preserved");
+        qc_do_adv(0);
+        qc_do_adv(0);  // pi -> 2
+        qc_do_build(0, 8'd5, 64'h1000, 16'd4, 1'b0);
+        qc_rd_ctx = 0;
+        #1;
+        chk(qc_o_sq_pi, 2, "ctx0 pi preserved on config-only re-commit");
+
+        $display("[qp_ctx] re-commit same id with rebind=1 -> sq_pi zeroed");
+        qc_do_build(0, 8'd5, 64'h1000, 16'd4, 1'b1);
+        qc_rd_ctx = 0;
+        #1;
+        chk(qc_o_sq_pi, 0, "ctx0 pi zeroed by rebind=1 (id unchanged)");
+
+        $display("[qp_ctx] commit different qp/base with rebind=0 -> sq_pi preserved");
+        qc_do_adv(0);
+        qc_do_adv(0);
+        qc_do_adv(0);  // pi -> 3
+        qc_do_build(0, 8'd7, 64'h9000, 16'd4, 1'b0);
+        qc_rd_ctx = 0;
+        #1;
+        chk(qc_o_qp_num, 7, "ctx0 qp_num updated to 7");
+        chk(qc_o_sq_pi, 3, "ctx0 pi preserved (rebind=0)");
+
+        $display("[qp_ctx] two contexts independent + per-ctx rebind isolation");
+        qc_do_build(0, 8'd5, 64'h1000, 16'd4, 1'b1);  // ctx0 fresh -> pi=0
+        qc_do_build(1, 8'd9, 64'h2000, 16'd8, 1'b1);  // ctx1 fresh -> pi=0
+        qc_do_adv(0);
+        qc_do_adv(0);  // ctx0's pi -> 2
+        qc_do_adv(1);  // ctx1's pi -> 1
+        qc_rd_ctx = 0;
+        #1;
+        chk(qc_o_sq_pi, 2, "ctx0's pi=2");
+        qc_rd_ctx = 1;
+        #1;
+        chk(qc_o_sq_pi, 1, "ctx1's pi=1");
+        qc_do_build(0, 8'd5, 64'h1000, 16'd4, 1'b1);  // rebind ctx0 -> its pi zeroed
+        qc_rd_ctx = 0;
+        #1;
+        chk(qc_o_sq_pi, 0, "ctx0's pi after rebind");
+        qc_rd_ctx = 1;
+        #1;
+        chk(qc_o_sq_pi, 1, "ctx1's pi untouched by ctx0 rebind");
+
+        $display("");
+        if (errors == 0) $display("==== tb_hh_ctx_ring: PASSED ====");
+        else $display("==== tb_hh_ctx_ring: FAILED (%0d) ====", errors);
+        $finish;
+    end
+
+    initial begin
+        #100000;
+        $display("TIMEOUT");
+        $finish;
+    end
+endmodule
+
+`default_nettype wire
diff -r -N -U0 -w -B a/hw/local_ip_cores/hw_handshake_v1_0/hdl/tb_hh_rtt.v b/hw/local_ip_cores/hw_handshake_v1_0/hdl/tb_hh_rtt.v
--- a/hw/local_ip_cores/hw_handshake_v1_0/hdl/tb_hh_rtt.v	1969-12-31 19:00:00.000000000 -0500
+++ b/hw/local_ip_cores/hw_handshake_v1_0/hdl/tb_hh_rtt.v	2026-08-27 09:49:29.245251688 -0400
@@ -0,0 +1,574 @@
+//===----------------------------------------------------------------------===//
+// tb_hh_rtt.v - check rtt measurement
+//
+// checks:
+//     1. reply-poll: shift the reply delay by +100 cyc -> RTT must grow by +100.
+//     2. complete_on_send: rtt must be independent of the reply delay (it completes at the send-CQ)
+//     3. reply-poll + timeout, peer disabled: must report timeout, not a reply
+//
+// build/run: iverilog -g2012 -o tb.vvp hh_orchestrator.v tb_hh_rtt.v && vvp tb.vvp
+//        or: xvlog hh_orchestrator.v tb_hh_rtt.v && xelab tb_hh_rtt -R
+//===----------------------------------------------------------------------===//
+`timescale 1ns / 1ps `default_nettype wire
+
+module tb_hh_rtt;
+    localparam ADDRW = 64, DATAW = 512, QPW = 8;
+
+    localparam integer WDLAT = 3;  // write-DMA  req -> done
+    localparam integer RDLAT = 2;  // read-DMA   req -> done
+    localparam integer RINGLAT = 2;  // doorbell   ring_req -> ring_done
+    localparam integer SENDLAT = 4;  // ring_done -> send_compl (ERNIC send)
+    localparam integer TOL = 10;
+
+    localparam [31:0] SEQ_OFF = 32'd36;
+    localparam [31:0] REPLYVAL = 32'h5c5c_5c5c;
+
+    // clock and reset
+    reg clk = 1'b0, rstn = 1'b0;
+    always #5 clk = ~clk;
+    reg [63:0] tb_cyc = 0;
+    always @(posedge clk) tb_cyc <= rstn ? tb_cyc + 64'd1 : 64'd0;
+
+    // DUT config inputs
+    reg start_pulse = 0, abort = 0;
+    reg [QPW-1:0] cfg_qp_num = 1, cfg_timer_qp_sel = 1;
+    reg [ADDRW-1:0] cfg_data_buf = 64'h3000, cfg_sq_base = 64'h1000, cfg_reply_buf = 64'h2000;
+    reg [12:0] cfg_payload_len = 13'd64;
+    reg [31:0] cfg_pattern = 32'hA5A5A5A5, cfg_reply_to = 0, cfg_reply_seq_off = SEQ_OFF;
+    reg [     15:0] cfg_sq_depth = 16'd16;
+    reg [DATAW-1:0] wqe_data = 512'hCAFE;
+    reg [      3:0] cfg_run_wqe_idx = 4'd0;
+    reg cfg_repost_wqe = 1, cfg_write_payload = 0, cfg_complete_on_send = 0, cfg_reply_poll = 0;
+
+    // DUT <-> model wires
+    wire             dma_req;
+    wire [ADDRW-1:0] dma_addr;
+    wire [      8:0] dma_beats;
+    wire [DATAW-1:0] dma_fill;
+    reg dma_busy = 0, dma_done = 0, dma_err = 0;
+    wire             rd_req;
+    wire [ADDRW-1:0] rd_addr;
+    reg rd_busy = 0, rd_done = 0, rd_err = 0;
+    reg  [DATAW-1:0] rd_data = 0;
+    wire             ring_req;
+    wire [  QPW-1:0] ring_qp;
+    wire [     15:0] ring_pi;
+    reg ring_done = 0, send_compl = 0, reply = 0;
+    reg  [QPW-1:0] reply_qp = 0;
+    wire [    3:0] sts_state;
+    wire sts_busy, sts_done, sts_timeout, sts_axi_err, sts_reply_seen, sts_update;
+    wire [     31:0] sts_round_cnt;
+    wire [     63:0] sts_rtt;
+
+    wire [  QPW-1:0] qpc_qp_num = cfg_qp_num;
+    wire [ADDRW-1:0] qpc_sq_base = cfg_sq_base;
+    wire [     15:0] qpc_sq_depth = cfg_sq_depth;
+    wire             qpc_complete_on_send = cfg_complete_on_send;
+    wire             qpc_reply_poll = cfg_reply_poll;
+    wire [     31:0] qpc_reply_to = cfg_reply_to;
+    wire [     31:0] qpc_reply_seq_off = cfg_reply_seq_off;
+    wire [ADDRW-1:0] qpc_reply_buf = cfg_reply_buf;
+    wire [      5:0] qpc_reply_stride_log2 = 6'd0;
+    wire [2:0] qpc_rd_ctx, qpc_adv_idx;
+    wire        qpc_adv;
+    reg  [15:0] sq_pi_model;
+    wire [15:0] qpc_sq_pi = sq_pi_model;
+    always @(posedge clk)
+        if (!rstn) sq_pi_model <= 16'd0;
+        else if (qpc_adv)
+            sq_pi_model <= (sq_pi_model >= cfg_sq_depth - 16'd1) ? 16'd0 : sq_pi_model + 16'd1;
+
+    // buffer-ring model: idx pinned at 0
+    wire [3:0] buf_ring_rd_idx, buf_ring_adv_idx;
+    wire        buf_ring_adv;
+    wire [15:0] buf_ring_adv_len;
+    wire [15:0] buf_ring_idx = 16'd0;
+    wire        buf_ring_seq_adv;
+    reg  [31:0] ring_seq_model;
+    wire [31:0] buf_ring_seq = ring_seq_model;
+    always @(posedge clk)
+        if (!rstn) ring_seq_model <= 32'd0;
+        else if (buf_ring_seq_adv) ring_seq_model <= ring_seq_model + 32'd1;
+
+    // DUT
+    hh_orchestrator #(
+        .C_M_AXI_ADDR_WIDTH(ADDRW),
+        .C_M_AXI_DATA_WIDTH(DATAW),
+        .C_QP_IDX_WIDTH    (QPW)
+    ) dut (
+        .core_clk             (clk),
+        .core_rstn            (rstn),
+        .start_pulse          (start_pulse),
+        .abort                (abort),
+        .wqe_data             (wqe_data),
+        .cfg_run_wqe_idx      (cfg_run_wqe_idx),
+        .wqe_build            (1'b0),
+        .wqe_build_idx        (4'd0),
+        .cfg_timer_qp_sel     (cfg_timer_qp_sel),
+        .cfg_repost_wqe       (cfg_repost_wqe),
+        .dma_req              (dma_req),
+        .dma_addr             (dma_addr),
+        .dma_beats            (dma_beats),
+        .dma_fill             (dma_fill),
+        .dma_busy             (dma_busy),
+        .dma_done             (dma_done),
+        .dma_err              (dma_err),
+        .rd_req               (rd_req),
+        .rd_addr              (rd_addr),
+        .rd_busy              (rd_busy),
+        .rd_done              (rd_done),
+        .rd_data              (rd_data),
+        .rd_err               (rd_err),
+        .ring_req             (ring_req),
+        .ring_qp              (ring_qp),
+        .ring_pi              (ring_pi),
+        .ring_done            (ring_done),
+        .send_compl           (send_compl),
+        .reply                (reply),
+        .reply_qp             (reply_qp),
+        .qpc_rd_ctx           (qpc_rd_ctx),
+        .qpc_qp_num           (qpc_qp_num),
+        .qpc_sq_base          (qpc_sq_base),
+        .qpc_sq_depth         (qpc_sq_depth),
+        .qpc_sq_pi            (qpc_sq_pi),
+        .qpc_reply_buf        (qpc_reply_buf),
+        .qpc_complete_on_send (qpc_complete_on_send),
+        .qpc_reply_poll       (qpc_reply_poll),
+        .qpc_reply_to         (qpc_reply_to),
+        .qpc_reply_seq_off    (qpc_reply_seq_off),
+        .qpc_reply_stride_log2(qpc_reply_stride_log2),
+        .qpc_adv              (qpc_adv),
+        .qpc_adv_idx          (qpc_adv_idx),
+        .buf_ring_rd_idx      (buf_ring_rd_idx),
+        .buf_ring_idx         (buf_ring_idx),
+        .buf_ring_seq         (buf_ring_seq),
+        .buf_ring_adv         (buf_ring_adv),
+        .buf_ring_seq_adv     (buf_ring_seq_adv),
+        .buf_ring_adv_idx     (buf_ring_adv_idx),
+        .buf_ring_adv_len     (buf_ring_adv_len),
+        .sts_state            (sts_state),
+        .sts_busy             (sts_busy),
+        .sts_done             (sts_done),
+        .sts_timeout          (sts_timeout),
+        .sts_axi_err          (sts_axi_err),
+        .sts_reply_seen       (sts_reply_seen),
+        .sts_round_cnt        (sts_round_cnt),
+        .sts_rtt              (sts_rtt),
+        .sts_last_rd          (),
+        .sts_update           (sts_update)
+    );
+
+    // The reply slot in DDR
+    reg [31:0] reply_val;
+    reg [31:0] reply_seq_mem;
+    reg [DATAW-1:0] reply_slot;
+    always @(*) begin
+        reply_slot                 = {DATAW{1'b0}};
+        reply_slot[31:0]           = reply_val;
+        reply_slot[SEQ_OFF*8+:32]  = reply_seq_mem;
+    end
+
+    // write-DMA model: req -> done after WDLAT
+    reg [ADDRW-1:0] wd_addr_l;
+    reg [DATAW-1:0] wd_fill_l;
+    reg [7:0] wd_cnt;
+    reg wd_act = 0;
+    always @(posedge clk) begin
+        dma_done <= 1'b0;
+        if (!rstn) begin
+            wd_act   <= 0;
+            dma_busy <= 0;
+        end else if (dma_req && !wd_act) begin
+            wd_act    <= 1;
+            dma_busy  <= 1;
+            wd_cnt    <= WDLAT[7:0];
+            wd_addr_l <= dma_addr;
+            wd_fill_l <= dma_fill;
+        end else if (wd_act) begin
+            if (wd_cnt == 0) begin
+                dma_done <= 1;
+                dma_busy <= 0;
+                wd_act   <= 0;
+            end else wd_cnt <= wd_cnt - 8'd1;
+        end
+    end
+
+    // read-DMA model: req -> done after RDLAT, returns reply_mem
+    reg [7:0] rd_cnt;
+    reg       rd_act = 0;
+    always @(posedge clk) begin
+        rd_done <= 1'b0;
+        if (!rstn) begin
+            rd_act  <= 0;
+            rd_busy <= 0;
+            rd_data <= 0;
+        end else if (rd_req && !rd_act) begin
+            rd_act  <= 1;
+            rd_busy <= 1;
+            rd_cnt  <= RDLAT[7:0];
+        end else if (rd_act) begin
+            if (rd_cnt == 0) begin
+                rd_done <= 1;
+                rd_busy <= 0;
+                rd_act  <= 0;
+                rd_data <= reply_slot;  // the whole 64B beat; the engine picks seq_num out of it
+            end else rd_cnt <= rd_cnt - 8'd1;
+        end
+    end
+
+    // doorbell model: ring_req->ring_done, then send_compl
+    reg [7:0] ring_cnt;
+    reg       ring_act = 0;
+    reg [7:0] send_cnt;
+    reg       send_pend = 0;
+    always @(posedge clk) begin
+        ring_done  <= 1'b0;
+        send_compl <= 1'b0;
+        if (!rstn) begin
+            ring_act  <= 0;
+            send_pend <= 0;
+        end else begin
+            if (ring_req && !ring_act) begin
+                ring_act <= 1;
+                ring_cnt <= RINGLAT[7:0];
+            end else if (ring_act) begin
+                if (ring_cnt == 0) begin
+                    ring_done <= 1;
+                    ring_act  <= 0;
+                    send_pend <= 1;
+                    send_cnt  <= SENDLAT[7:0];
+                end else ring_cnt <= ring_cnt - 8'd1;
+            end
+            if (send_pend) begin
+                if (send_cnt == 0) begin
+                    send_compl <= 1;
+                    send_pend  <= 0;
+                end else send_cnt <= send_cnt - 8'd1;
+            end
+        end
+    end
+
+    // "peer": REPLY_DELAY cycles after send_compl, write the reply
+    reg [15:0] REPLY_DELAY = 20;
+    reg        peer_en = 1;
+    reg [15:0] rep_cnt;
+    reg        rep_pend = 0;
+    reg        peer_fire;
+    reg [63:0] c_reply;
+    always @(posedge clk) begin
+        peer_fire <= 1'b0;
+        if (!rstn) rep_pend <= 0;
+        else if (send_compl && peer_en) begin
+            rep_pend <= 1;
+            rep_cnt  <= REPLY_DELAY;
+        end else if (rep_pend) begin
+            if (rep_cnt == 0) begin
+                peer_fire <= 1;
+                rep_pend  <= 0;
+                c_reply   <= tb_cyc;
+            end else rep_cnt <= rep_cnt - 16'd1;
+        end
+    end
+
+    // The peer's reply
+    reg peer_stale = 1'b0;
+    always @(posedge clk) begin
+        if (!rstn) begin
+            reply_val     <= 32'd0;
+            reply_seq_mem <= 32'd0;  // an empty slot: no round has sequence 0
+        end else if (peer_fire) begin
+            reply_val     <= REPLYVAL + buf_ring_seq;
+            reply_seq_mem <= peer_stale ? (buf_ring_seq - 32'd1) : buf_ring_seq;
+        end
+    end
+
+    // test harness
+    integer        errors = 0;
+    reg     [63:0] cap_rtt;
+    reg cap_rs, cap_to;
+    reg [63:0] rtt_a1, rtt_a2, rtt_a3, rtt_c1, rtt_c2;
+    reg     [     63:0] diff;
+
+    // continuous-mode capture: latest WQE-write address + ring PI
+    reg     [ADDRW-1:0] cap_dma_addr;
+    reg     [     15:0] cap_ring_pi;
+    integer             er;
+    reg [15:0] exp_pi_e, got_slot_e, exp_slot_e;
+
+    reg [7:0] wqe_wr_cnt, cap_wr_cnt;
+    always @(posedge clk) begin
+        if (dma_req) cap_dma_addr <= dma_addr;
+        if (ring_req) cap_ring_pi <= ring_pi;
+        if (start_pulse) wqe_wr_cnt <= 8'd0;
+        else if (dma_req) wqe_wr_cnt <= wqe_wr_cnt + 8'd1;
+    end
+
+    task run_round;
+        input [15:0] rdelay;
+        input pen;
+        begin
+            REPLY_DELAY = rdelay;
+            peer_en     = pen;
+            @(posedge clk);
+            wait (sts_busy == 1'b0);
+            @(posedge clk);
+            start_pulse <= 1'b1;
+            @(posedge clk);
+            start_pulse <= 1'b0;
+            @(posedge sts_done);
+            cap_rtt    = sts_rtt;
+            cap_rs     = sts_reply_seen;
+            cap_to     = sts_timeout;
+            cap_wr_cnt = wqe_wr_cnt;  // {front-post + refill} writes this round
+            @(posedge clk);
+        end
+    endtask
+
+    task expect_near;  // |a-b| <= tol
+        input [63:0] a, b;
+        input integer tol;
+        input [255:0] name;
+        begin
+            diff = (a >= b) ? (a - b) : (b - a);
+            if (diff <= tol)
+                $display("  PASS  %0s   (got %0d, expect ~%0d, |d|=%0d)", name, a, b, diff);
+            else begin
+                $display("  FAIL  %0s   (got %0d, expect ~%0d, |d|=%0d)", name, a, b, diff);
+                errors = errors + 1;
+            end
+        end
+    endtask
+
+    task expect_eq;
+        input cond;
+        input [255:0] name;
+        begin
+            if (cond) $display("  PASS  %0s", name);
+            else begin
+                $display("  FAIL  %0s", name);
+                errors = errors + 1;
+            end
+        end
+    endtask
+
+    // reset pulse (each test is self-contained so it can run standalone for its own VCD)
+    task do_reset;
+        begin
+            peer_stale = 1'b0;
+            rstn = 1'b0;
+            repeat (6) @(posedge clk);
+            rstn = 1'b1;
+            @(posedge clk);
+        end
+    endtask
+
+    task test_A;
+        begin
+            do_reset;
+            $display("\n[Test A] reply-poll rtt must track the reply delay");
+            cfg_reply_poll       = 1;
+            cfg_complete_on_send = 0;
+            cfg_repost_wqe       = 1;
+            cfg_write_payload    = 0;
+            cfg_reply_to         = 0;
+            run_round(16'd20, 1'b1);
+            rtt_a1 = cap_rtt;
+            $display("  round delay=20  -> rtt=%0d cyc  reply_seen=%b timeout=%b", rtt_a1, cap_rs,
+                     cap_to);
+            expect_eq(cap_rs == 1'b1, "A1 reply_seen set");
+            expect_eq(cap_to == 1'b0, "A1 no timeout");
+            run_round(16'd120, 1'b1);
+            rtt_a2 = cap_rtt;
+            $display("  round delay=120 -> rtt=%0d cyc", rtt_a2);
+            expect_near(rtt_a2 - rtt_a1, 64'd100, TOL, "A delta-rtt == delta-delay (+100)");
+            run_round(16'd220, 1'b1);
+            rtt_a3 = cap_rtt;
+            $display("  round delay=220 -> rtt=%0d cyc", rtt_a3);
+            expect_near(rtt_a3 - rtt_a2, 64'd100, TOL, "A linearity (+100 again)");
+        end
+    endtask
+
+    task test_B;
+        begin
+            do_reset;
+            $display("\n[Test B] complete_on_send rtt must be independent of reply delay");
+            cfg_reply_poll       = 0;
+            cfg_complete_on_send = 1;
+            cfg_repost_wqe       = 1;
+            cfg_write_payload    = 0;
+            cfg_reply_to         = 0;
+            run_round(16'd20, 1'b1);
+            rtt_c1 = cap_rtt;
+            run_round(16'd500, 1'b1);
+            rtt_c2 = cap_rtt;
+            $display("  delay=20 -> rtt=%0d ; delay=500 -> rtt=%0d", rtt_c1, rtt_c2);
+            expect_near(rtt_c2, rtt_c1, 2, "B complete_on_send rtt reply-independent");
+        end
+    endtask
+
+    task test_C;
+        begin
+            do_reset;
+            $display("\n[Test C] reply-poll + timeout, peer disabled -> timeout");
+            cfg_reply_poll       = 1;
+            cfg_complete_on_send = 0;
+            cfg_repost_wqe       = 1;
+            cfg_write_payload    = 0;
+            cfg_reply_to         = 32'd80;
+            run_round(16'd9999, 1'b0);  // peer_en=0 -> never replies
+            $display("  rtt=%0d reply_seen=%b timeout=%b", cap_rtt, cap_rs, cap_to);
+            expect_eq(cap_to == 1'b1, "C timeout asserted");
+            expect_eq(cap_rs == 1'b0, "C reply_seen not set");
+        end
+    endtask
+
+    task test_D;
+        begin
+            do_reset;
+            $display(
+                "\n[Test D] always-repost - PI wraps at depth, WQE slot advances/wraps, one post per round");
+            cfg_reply_poll       = 0;
+            cfg_complete_on_send = 1;
+            cfg_repost_wqe       = 1;
+            cfg_write_payload    = 0;
+            cfg_reply_to         = 0;
+            cfg_sq_depth         = 16'd4;
+            for (er = 0; er < 6; er = er + 1) begin
+                run_round(16'd20, 1'b1);  // completes on send_compl
+                // PI must WRAP at depth (ERNIC expects 1..depth cycling, like the driver):
+                // rounds 0..5 with depth 4 -> PI = 1,2,3,4,1,2
+                exp_pi_e   = (er[15:0] % cfg_sq_depth) + 16'd1;
+                got_slot_e = (cap_dma_addr - cfg_sq_base) >> 6;  // WQE-write slot = addr/64
+                exp_slot_e = er[15:0] % cfg_sq_depth;  // advances, wraps at depth(=4)
+                $display(
+                    "  round %0d: ring_pi=%0d (exp %0d)  wqe_slot=%0d (exp %0d)  wqe_writes=%0d  addr=0x%0h",
+                    er, cap_ring_pi, exp_pi_e, got_slot_e, exp_slot_e, cap_wr_cnt, cap_dma_addr);
+                expect_eq(cap_ring_pi == exp_pi_e, "D PI wraps at depth");
+                expect_eq(got_slot_e == exp_slot_e, "D WQE slot advances/wraps");
+                expect_eq(cap_wr_cnt == 8'd1, "D exactly one WQE post per round (always-repost)");
+            end
+        end
+    endtask
+
+    // Hiding latecy by reposting WQE in the background
+    task test_E;
+        begin
+            do_reset;
+            $display("\n[Test E] reply-poll latency-hiding: round0 front-posts, round>=1 skips");
+            cfg_reply_poll       = 1;
+            cfg_complete_on_send = 0;
+            cfg_repost_wqe       = 1;
+            cfg_write_payload    = 0;
+            cfg_reply_to         = 0;
+            // round 0   = front WQE post + background repost = 2 writes;
+            // round >=1 = background repost only             = 1 write.
+            for (er = 0; er < 4; er = er + 1) begin
+                run_round(16'd20, 1'b1);
+                $display("  round %0d: reply_seen=%b wqe_writes=%0d (exp %0d)", er, cap_rs,
+                         cap_wr_cnt, (er == 0) ? 2 : 1);
+                expect_eq(cap_rs == 1'b1, "E reply seen");
+                if (er == 0) expect_eq(cap_wr_cnt == 8'd2, "E round0 front-post + repost (2)");
+                else expect_eq(cap_wr_cnt == 8'd1, "E round>=1 repost only, front post skipped (1)");
+            end
+        end
+    endtask
+
+    // changing cfg_run_wqe_idx invalidates the background pre-post
+    // so repost the new WQE in-band
+    task test_F;
+        begin
+            do_reset;
+            $display("\n[Test F] WQE index change forces an in-band re-post");
+            cfg_reply_poll       = 1;
+            cfg_complete_on_send = 0;
+            cfg_repost_wqe       = 1;
+            cfg_write_payload    = 0;
+            cfg_reply_to         = 0;
+            cfg_run_wqe_idx      = 4'd0;
+
+            for (er = 0; er < 3; er = er + 1) begin
+                run_round(16'd20, 1'b1);
+                $display("  round %0d (idx=0): wqe_writes=%0d (exp %0d)", er, cap_wr_cnt,
+                         (er == 0) ? 2 : 1);
+                expect_eq(cap_wr_cnt == ((er == 0) ? 8'd2 : 8'd1), "F fixed-index post count");
+            end
+
+            // change the selected WQE -> stale pre-post -> next round re-posts in-band
+            cfg_run_wqe_idx = 4'd1;
+            run_round(16'd20, 1'b1);
+            $display("  round 3 (idx 0->1): wqe_writes=%0d (exp 2 = re-post)", cap_wr_cnt);
+            expect_eq(cap_wr_cnt == 8'd2, "F index change -> in-band re-post (2)");
+
+            // index now stable at 1
+            run_round(16'd20, 1'b1);
+            $display("  round 4 (idx=1): wqe_writes=%0d (exp 1 = skip again)", cap_wr_cnt);
+            expect_eq(cap_wr_cnt == 8'd1, "F stable index -> skip again (1)");
+            cfg_run_wqe_idx = 4'd0;
+        end
+    endtask
+
+    task test_G;
+        begin
+            do_reset;
+            $display("\n[Test G] a reply is matched by sequence, not by contents");
+            cfg_reply_poll       = 1;
+            cfg_complete_on_send = 0;
+            cfg_repost_wqe       = 1;
+            cfg_write_payload    = 0;
+
+            // G1: an all-zero reply completes the round.
+            cfg_reply_to = 0;
+            run_round(16'd20, 1'b1);
+            expect_eq(cap_rs == 1'b1, "G1 first round seen");
+            force reply_val = 32'd0;
+            run_round(16'd20, 1'b1);
+            $display("  zero-valued reply: reply_seen=%b timeout=%b", cap_rs, cap_to);
+            expect_eq(cap_rs == 1'b1, "G1 a correction of 0 is an ordinary reply");
+            release reply_val;
+
+            // G2: a reply carrying the prev. round's sequence must not be taken for this round's.
+            do_reset;
+            cfg_reply_to = 32'd400;
+            run_round(16'd20, 1'b1);
+            expect_eq(cap_rs == 1'b1, "G2 first round seen");
+            peer_stale = 1'b1;
+            run_round(16'd20, 1'b1);
+            $display("  stale-sequence reply: reply_seen=%b timeout=%b", cap_rs, cap_to);
+            expect_eq(cap_rs == 1'b0, "G2 an older sequence is not this round's reply");
+            expect_eq(cap_to == 1'b1, "G2 the round times out instead");
+            peer_stale   = 1'b0;
+            cfg_reply_to = 0;
+        end
+    endtask
+
+    // vvp tb.vvp +TEST=A +VCD=tb_A.vcd ; vvp tb.vvp +TEST=B +VCD=tb_B.vcd ; ...
+    reg [  8*8-1:0] testsel;
+    reg [8*256-1:0] vcdname;
+    initial begin
+        if (!$value$plusargs("TEST=%s", testsel)) testsel = "ALL";
+        if (!$value$plusargs("VCD=%s", vcdname)) vcdname = "tb_hh_rtt.vcd";
+        $dumpfile(vcdname);
+        $dumpvars(0, tb_hh_rtt);
+        $display("[tb] TEST=%0s  VCD=%0s", testsel, vcdname);
+
+        if (testsel == "A" || testsel == "ALL") test_A;
+        if (testsel == "B" || testsel == "ALL") test_B;
+        if (testsel == "C" || testsel == "ALL") test_C;
+        if (testsel == "D" || testsel == "ALL") test_D;
+        if (testsel == "E" || testsel == "ALL") test_E;
+        if (testsel == "F" || testsel == "ALL") test_F;
+        if (testsel == "G" || testsel == "ALL") test_G;
+
+        if (errors == 0) $display("\n==================  ALL CHECKS PASSED  ==================\n");
+        else $display("\n==================  %0d CHECK(S) FAILED  ==================\n", errors);
+        $finish;
+    end
+
+    initial begin
+        #200000;
+        $display("\nTIMEOUT: DUT did not finish, possible hang. errors so far=%0d", errors);
+        $finish;
+    end
+endmodule
+
+`default_nettype wire
